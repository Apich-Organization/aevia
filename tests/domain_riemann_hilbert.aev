import Rssn_RiemannHilbert as Rh
import Rssn_numerical_callback as Numeric

let zero = complex(0.0, 0.0)
let one = complex(1.0, 0.0)

let density = [[zero, one], [zero, zero]]
let solution = { nodes = [-0.7745966692414834, 0.0, 0.7745966692414834], weights = [5.0 / 9.0, 8.0 / 9.0, 5.0 / 9.0], density = [density, density, density] }

test "collocation density can be reused above and below the contour" =
    match (Rh.evaluate(solution, complex(0.0, 1e-10)), Rh.evaluate(solution, complex(0.0, -1e-10)), Rh.evaluate(solution, zero)) with
    | (Ok(upper), Ok(lower), Err(_)) -> approx_eq(re(at(at(upper, 0), 1)), 0.5, 1e-9) && approx_eq(re(at(at(lower, 0), 1)), -0.5, 1e-9)
    | _ -> false

test "matrix inverse cancels the dimensions of its input" =
    match Rh.matrix([complex(2.0 m, 0.0 m), complex(1.0 m, 0.0 m), complex(0.0 m, 0.0 m), complex(4.0 m, 0.0 m)]) with
    | Ok(matrix) ->
        match Rh.inverse(matrix) with
        | Ok(Some(inv)) ->
            match Rh.multiply(matrix, inv) with
            | Ok(identity) -> approx_eq(re(at(at(identity, 0), 0)), 1.0, 1e-12) && approx_eq(re(at(at(identity, 0), 1)), 0.0, 1e-12)
            | Err(_) -> false
        | _ -> false
    | Err(_) -> false

fn jump(t: Float): Tensor<[2, 2], Complex> = [[one, complex(to_real(1.0 - t * t), 0.0)], [zero, one]]

test "a nilpotent jump yields a reusable collocation solution" =
    match Numeric.num_riemann_hilbert_solve_typed(16, 18, jump) with
    | Ok(result) ->
        match Rh.evaluate(result.solution, complex(0.0, 1.0)) with
        | Ok(matrix) -> result.evaluations == 18 && approx_eq(re(at(at(matrix, 0), 1)), (pi - 2.0) / (2.0 * pi), 1e-9)
        | Err(_) -> false
    | Err(_) -> false
