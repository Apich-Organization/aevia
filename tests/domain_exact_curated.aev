## Typed NumberTheory and Numeric domain adapters use the same native kernels.
import Rssn_NumberTheory as Number
import Rssn_Numeric as Numeric

test "extended gcd exposes the unbounded signed coefficients by name" =
    let a = -2041694201525630780780247644590609268736
    let b = 5104235503814076951950619111476523171840
    match Number.bigint_xgcd(a, b) with
    | Ok(r) -> r.gcd == 1020847100762815390390123822295304634368 && a * r.x + b * r.y == r.gcd
    | Err(_) -> false

test "a valid no-inverse result is distinct from an ABI error" =
    Number.bigint_mod_inverse(6, 15) == Ok(None) && Number.bigint_mod_inverse(2, 11) == Ok(Some(6))

test "the exact solver retains rational residuals after normalization" =
    match Numeric.exact_matrix([[3, 0], [0, 2]], 1) with
    | Ok(a) -> Numeric.exact_solve_dixon(a, [1, -1]) == Ok(Some([1 / 3, -1 / 2]))
    | Err(_) -> false

test "a solution handle exports exact matrix coefficients" =
    match (Numeric.exact_matrix([[2, 4]], 1), Numeric.exact_matrix([[6, 8]], 1)) with
    | (Ok(a), Ok(b)) -> match Numeric.exact_solve_matrix(a, b) with
        | Ok(Some(x)) -> Numeric.exact_matrix_entries(x) == Ok([[3, 4], [0, 0]])
        | _ -> false
    | _ -> false

test "measured normalization preserves exact coefficient values" =
    let measured: Tensor<2, Real[Length]> = [[4 m, 6 m], [10 m, 8 m]]
    match Numeric.exact_matrix(measured, 2 m) with
    | Ok(a) -> Numeric.exact_matrix_entries(a) == Ok([[2, 3], [5, 4]])
    | Err(_) -> false

test "zero or negative reference produces a typed native error" =
    let measured: Tensor<2, Real[Length]> = [[1 m]]
    match (Numeric.exact_matrix(measured, 0 m), Numeric.exact_matrix(measured, -1 m)) with
    | (Err(_), Err(_)) -> true
    | _ -> false
