import Rssn_Univalent as Univalent

let koebe = [complex(0.0, 0.0), complex(1.0, 0.0), complex(2.0, 0.0), complex(3.0, 0.0), complex(4.0, 0.0), complex(5.0, 0.0)]

test "Koebe passes Bieberbach and has identity Grunsky matrix" =
    match Univalent.grunsky_matrix(koebe, 2) with
    | Ok(g) ->
        let bound = Univalent.bieberbach(koebe, 1e-12) == Ok(true)
        let diagonal = approx_eq(re(g[0, 0]), 1.0, 1e-12) && approx_eq(re(g[1, 1]), 1.0, 1e-12)
        let off_diagonal = approx_eq(magnitude(g[0, 1]), 0.0, 1e-12)
        let inequality = Univalent.grunsky_check(g, [complex(1.0, 0.3), complex(0.0, -0.7)], 1e-12) == Ok(true)
        bound && diagonal && off_diagonal && inequality
    | Err(_) -> false

test "normalized Hankel and Fekete–Szegő diagnostics" =
    match Univalent.hankel(koebe, 2, 1) with
    | Ok(det) ->
        let functional = Univalent.fekete_szego(complex(2.0, 0.0), complex(3.0, 0.0), complex(1.0, 0.0))
        approx_eq(re(det), -1.0, 1e-12) && functional == Ok(1.0)
    | Err(_) -> false

test "Becker and Loewner preserve an analytic fixed point" =
    match Univalent.loewner_step(complex(0.0, 0.0), 0.4, 0.01) with
    | Ok(z) -> approx_eq(magnitude(z), 0.0, 1e-15) && Univalent.becker(complex(0.5, 0.0), complex(1.0, 0.0), complex(0.0, 0.0)) == Ok(true)
    | Err(_) -> false

test "oversized order is rejected before constructing a matrix" =
    match Univalent.grunsky_matrix(koebe, 93) with
    | Ok(_) -> false
    | Err(_) -> true
