import Rssn_numerical_callback as Root

fn squared_minus_two(z: Complex): Complex = z * z - complex(2.0, 0.0)
fn squared_derivative(z: Complex): Complex = complex(2.0, 0.0) * z

fn measured_residual(z: Complex[Length]): Complex[Length] =
    z - complex(1.4 m, 0.3 m)
fn measured_slope(_z: Complex[Length]): Complex = complex(1.0, 0.0)
fn measured_curvature(_z: Complex[Length]): Complex[1/Length] =
    complex(0.0 / (1.0 m), 0.0 / (1.0 m))

fn moving_residual(z: Complex[Length], t: Float): Complex[Length] =
    z - complex(1.0 m + (2.0 m) * to_real(t), 0.0 m)
fn moving_slope(_z: Complex[Length], _t: Float): Complex = complex(1.0, 0.0)
fn moving_time(_z: Complex[Length], _t: Float): Complex[Length] = complex(-2.0 m, 0.0 m)

test "Muller uses a shared evaluation budget and rejects a duplicate nonroot" =
    let first = complex(1.0, 0.0)
    let second = complex(1.2, 0.0)
    let third = complex(1.4, 0.0)
    let small_budget = Root.num_complex_root_muller_typed(first, second, third, 1.0, 1.0, 1e-12, 1, 3, squared_minus_two)
    let duplicate = Root.num_complex_root_muller_typed(third, third, third, 1.0, 1.0, 1e-12, 5, 25, squared_minus_two)
    match Root.num_complex_root_muller_typed(first, second, third, 1.0, 1.0, 1e-12, 1, 4, squared_minus_two) with
    | Ok(result) -> result.evaluations == 4 && approx_eq(re(result.root), 1.4142135623730951, 1e-12) && is_err(small_budget) && is_err(duplicate)
    | Err(_) -> false

test "Halley keeps root units and checks second derivative units" =
    match Root.num_complex_root_halley_typed(complex(1.0 m, 0.0 m), 2.0 m, 5.0 m, 1e-11, 8, 30, measured_residual, measured_slope, measured_curvature) with
    | Ok(result) -> result.evaluations == 4 && approx_eq(re(result.root) / (1.0 m), 1.4, 1e-11) && approx_eq(im(result.root) / (1.0 m), 0.3, 1e-11)
    | Err(_) -> false

test "homotopy reaches the specified endpoint with measured callbacks" =
    match Root.num_complex_root_homotopy_typed(complex(1.0 m, 0.0 m), 2.0 m, 3.0 m, 1e-11, 12, 3, 256, moving_residual, moving_slope, moving_time) with
    | Ok(result) -> result.evaluations < 256 && approx_eq(re(result.root) / (1.0 m), 3.0, 1e-11)
    | Err(_) -> false

test "Delves–Lyness reconstructs two sampled roots without resampling the circle" =
    match Root.num_complex_root_delves_lyness_typed(complex(0.0, 0.0), 2.0, 1.0, 96, 220, squared_minus_two, squared_derivative) with
    | Ok(result) -> result.evaluations >= 192 && result.evaluations <= 198 && approx_eq(abs(re(at(result.roots, 0))), 1.4142135623730951, 1e-11) && approx_eq(re(at(result.roots, 0)) + re(at(result.roots, 1)), 0.0, 1e-11)
    | Err(_) -> false
