#423=EDGE_LOOP('',(#404,#409,#414));
#424=FACE_OUTER_BOUND('',#423,.T.);
#425=ADVANCED_FACE('',(#424),#422,.T.);
#600=CLOSED_SHELL('',(#125,#225,#325,#425));
#601=MANIFOLD_SOLID_BREP('',#600);
#602=SI_UNIT(.CENTI.,.METRE.);
ENDSEC;
END-ISO-10303-21;
"""

test "planar STEP text applies its declared length unit before creating a mesh" =
    match Cad.read_step_text(planar_step) with
    | Ok(parts) -> length(parts) == 1 && tetra_volume(parts[0]) && Cad.release_mesh(parts[0]) == Ok(true)
    | Err(_) -> false

test "convex solid intersection retains coherent volume and checks the operation" =
    match Cad.mesh_new(vertices, triangles) with
    | Ok(mesh) ->
        match Cad.mesh_boolean(mesh, mesh, "intersection") with
        | Ok(result) ->
            (tetra_volume(result) && fails(Cad.mesh_boolean(mesh, mesh, "invalid"))
                && Cad.release_mesh(result) == Ok(true) && Cad.release_mesh(mesh) == Ok(true))
        | Err(_) -> false
    | Err(_) -> false
