## Measured indexed CAD, bounded solid operations and in-memory interchange.
import Rssn_Cad as Cad

let vertices = [[0.0 cm, 0.0 cm, 0.0 cm], [100.0 cm, 0.0 cm, 0.0 cm],
                [0.0 cm, 100.0 cm, 0.0 cm], [0.0 cm, 0.0 cm, 100.0 cm]]
let triangles = [[0, 2, 1], [0, 1, 3], [0, 3, 2], [1, 2, 3]]

fn fails<T>(result: Result<T, OpError>): Bool =
    match result with
    | Err(_) -> true
    | Ok(_) -> false

fn tetra_volume(mesh: Cad.CadMesh): Bool =
    match Cad.signed_volume(mesh) with
    | Ok(volume) -> approx_eq(volume / (1.0 m^3), 1.0 / 6.0, 1e-12)
    | Err(_) -> false

test "indexed tetrahedron reports topology, volume and coherent length coordinates" =
    match Cad.mesh_new(vertices, triangles) with
    | Ok(mesh) ->
        match Cad.mesh_arrays(mesh) with
        | Ok(data) ->
            (Cad.vertex_count(mesh) == Ok(4) && Cad.triangle_count(mesh) == Ok(4)
                && Cad.is_closed(mesh) == Ok(true) && Cad.is_manifold(mesh) == Ok(true)
                && Cad.euler_characteristic(mesh) == Ok(2) && tetra_volume(mesh)
                && data.vertices[1][0] == 1.0 m && data.triangles == triangles
                && Cad.release_mesh(mesh) == Ok(true) && fails(Cad.vertex_count(mesh)))
        | Err(_) -> false
    | Err(_) -> false

test "repair reports the hole it closes and returns a new mesh" =
    match Cad.mesh_new(vertices, [[0, 2, 1], [0, 1, 3], [0, 3, 2]]) with
    | Ok(open_mesh) ->
        match Cad.repair(open_mesh, 0.0 m) with
        | Ok(result) ->
            (result.filled_holes == 1 && Cad.is_closed(open_mesh) == Ok(false)
                && tetra_volume(result.mesh) && Cad.release_mesh(result.mesh) == Ok(true)
                && Cad.release_mesh(open_mesh) == Ok(true))
        | Err(_) -> false
    | Err(_) -> false

test "binary and ASCII STL use the supplied length per coordinate and round trip in memory" =
    match Cad.mesh_new(vertices, triangles) with
    | Ok(original) ->
        match (Cad.write_stl_binary(original, 1.0 cm), Cad.write_stl_ascii(original, 1.0 cm, "solid")) with
        | (Ok(bytes), Ok(text)) ->
            match (Cad.read_stl(bytes, 1.0 cm), Cad.read_stl_text(text, 1.0 cm)) with
            | (Ok(binary_mesh), Ok(ascii_mesh)) ->
                match (Cad.weld(binary_mesh, 0.0 m), Cad.weld(ascii_mesh, 0.0 m)) with
                | (Ok(binary), Ok(ascii)) -> binary.merged_vertices == 8 && ascii.merged_vertices == 8 && tetra_volume(binary.mesh) && tetra_volume(ascii.mesh)
                | _ -> false
            | _ -> false
        | _ -> false
    | Err(_) -> false

test "mesh construction rejects out-of-range triangle indices" =
    fails(Cad.mesh_new(vertices, [[0, 1, 4]]))

let planar_step = """
ISO-10303-21;
HEADER;
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.,0.,0.));
#11=VERTEX_POINT('',#1);
#2=CARTESIAN_POINT('',(100.,0.,0.));
#12=VERTEX_POINT('',#2);
#3=CARTESIAN_POINT('',(0.,100.,0.));
#13=VERTEX_POINT('',#3);
#4=CARTESIAN_POINT('',(0.,0.,100.));
#14=VERTEX_POINT('',#4);
#100=DIRECTION('',(0.,1.,0.));
#101=VECTOR('',#100,100.);
#102=LINE('',#1,#101);
#103=EDGE_CURVE('',#11,#13,#102,.T.);
#104=ORIENTED_EDGE('',*,*,#103,.T.);
#105=DIRECTION('',(1.,-1.,0.));
#106=VECTOR('',#105,100.);
#107=LINE('',#3,#106);
#108=EDGE_CURVE('',#13,#12,#107,.T.);
#109=ORIENTED_EDGE('',*,*,#108,.T.);
#110=DIRECTION('',(-1.,0.,0.));
#111=VECTOR('',#110,100.);
#112=LINE('',#2,#111);
#113=EDGE_CURVE('',#12,#11,#112,.T.);
#114=ORIENTED_EDGE('',*,*,#113,.T.);
#120=DIRECTION('',(0.,0.,-1.));
#121=AXIS2_PLACEMENT_3D('',#1,#120,$);
#122=PLANE('',#121);
#123=EDGE_LOOP('',(#104,#109,#114));
#124=FACE_OUTER_BOUND('',#123,.T.);
#125=ADVANCED_FACE('',(#124),#122,.T.);
#200=DIRECTION('',(1.,0.,0.));
#201=VECTOR('',#200,100.);
#202=LINE('',#1,#201);
#203=EDGE_CURVE('',#11,#12,#202,.T.);
#204=ORIENTED_EDGE('',*,*,#203,.T.);
#205=DIRECTION('',(-1.,0.,1.));
#206=VECTOR('',#205,100.);
#207=LINE('',#2,#206);
#208=EDGE_CURVE('',#12,#14,#207,.T.);
#209=ORIENTED_EDGE('',*,*,#208,.T.);
#210=DIRECTION('',(0.,0.,-1.));
#211=VECTOR('',#210,100.);
#212=LINE('',#4,#211);
#213=EDGE_CURVE('',#14,#11,#212,.T.);
#214=ORIENTED_EDGE('',*,*,#213,.T.);
#220=DIRECTION('',(0.,-1.,0.));
#221=AXIS2_PLACEMENT_3D('',#1,#220,$);
#222=PLANE('',#221);
#223=EDGE_LOOP('',(#204,#209,#214));
#224=FACE_OUTER_BOUND('',#223,.T.);
#225=ADVANCED_FACE('',(#224),#222,.T.);
#300=DIRECTION('',(0.,0.,1.));
#301=VECTOR('',#300,100.);
#302=LINE('',#1,#301);
#303=EDGE_CURVE('',#11,#14,#302,.T.);
#304=ORIENTED_EDGE('',*,*,#303,.T.);
#305=DIRECTION('',(0.,1.,-1.));
#306=VECTOR('',#305,100.);
#307=LINE('',#4,#306);
#308=EDGE_CURVE('',#14,#13,#307,.T.);
#309=ORIENTED_EDGE('',*,*,#308,.T.);
#310=DIRECTION('',(0.,-1.,0.));
#311=VECTOR('',#310,100.);
#312=LINE('',#3,#311);
#313=EDGE_CURVE('',#13,#11,#312,.T.);
#314=ORIENTED_EDGE('',*,*,#313,.T.);
#320=DIRECTION('',(-1.,0.,0.));
#321=AXIS2_PLACEMENT_3D('',#1,#320,$);
#322=PLANE('',#321);
#323=EDGE_LOOP('',(#304,#309,#314));
#324=FACE_OUTER_BOUND('',#323,.T.);
#325=ADVANCED_FACE('',(#324),#322,.T.);
#400=DIRECTION('',(-1.,1.,0.));
#401=VECTOR('',#400,100.);
#402=LINE('',#2,#401);
#403=EDGE_CURVE('',#12,#13,#402,.T.);
#404=ORIENTED_EDGE('',*,*,#403,.T.);
#405=DIRECTION('',(0.,-1.,1.));
#406=VECTOR('',#405,100.);
#407=LINE('',#3,#406);
#408=EDGE_CURVE('',#13,#14,#407,.T.);
#409=ORIENTED_EDGE('',*,*,#408,.T.);
#410=DIRECTION('',(1.,0.,-1.));
#411=VECTOR('',#410,100.);
#412=LINE('',#4,#411);
#413=EDGE_CURVE('',#14,#12,#412,.T.);
#414=ORIENTED_EDGE('',*,*,#413,.T.);
#420=DIRECTION('',(1.,1.,1.));
#421=AXIS2_PLACEMENT_3D('',#2,#420,$);
