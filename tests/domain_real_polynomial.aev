## Numerical polynomial kernels take descending coefficient vectors.
import Rssn_Special as S

test "barycentric interpolation checks coordinates and preserves ordinate units" =
    let nodes = [-100.0 cm, 0.0 m, 1.0 m]
    let values = [3.0 s, 1.0 s, 3.0 s]
    match S.barycentric_interpolate(nodes, values, 50.0 cm) with
    | Ok(value) -> approx_eq(value, 1.5 s, 1e-13 s)
    | _ -> false

test "numeric polynomial power and GCD expose descending coefficients" =
    match (S.polynomial_power([1.0, -1.0], 3), S.polynomial_gcd([1.0, -3.0, 2.0], [1.0, 2.0, -3.0], 1e-12)) with
    | (Ok(power), Ok(gcd)) -> power == [1.0, -3.0, 3.0, -1.0] && length(gcd) == 2 && approx_eq(at(gcd, 0), 1.0, 1e-13) && approx_eq(at(gcd, 1), -1.0, 1e-13)
    | _ -> false

test "interpolation rejects duplicate nodes even on an exact query" =
    is_err(S.barycentric_interpolate([1.0, 1.0], [2.0, 3.0], 1.0))
