## Inspect the same portable record used by the state-space simulator.
import Rssn_numerical_matrix as Control

let a = [[-2.0 Hz, 0.0 Hz], [0.0 Hz, -4.0 Hz]]

let b = [[3.0 m/N/s], [2.0 m/N/s]]

let c = [[4.0 Pa/m, 5.0 Pa/m]]

let d = [[1.0 Pa/N]]

let model = Control.num_control_c2d_zoh(a, b, c, d, 0.25 s)

test "portable model exposes state, input and output counts" = Control.num_control_discrete_n_states(model) == 2 && Control.num_control_discrete_n_inputs(model) == 1 && Control.num_control_discrete_n_outputs(model) == 1

test "stable zero-order-hold model has both dimensionless poles" =
    let poles = Control.num_control_discrete_poles(model)
    length(poles) == 2 && Control.num_control_discrete_is_stable(model)

test "controllability and observability blocks preserve map units" =
    let reachable = Control.num_control_discrete_controllability_matrix(model)
    let observable = Control.num_control_discrete_observability_matrix(model)
    approx_eq(reachable[0, 0], model.b[0, 0], 1e-12 m/N) && approx_eq(reachable[0, 1], model.a[0, 0] * model.b[0, 0], 1e-12 m/N) && approx_eq(observable[0, 1], model.c[0, 1], 1e-12 Pa/m) && approx_eq(observable[1, 1], model.c[0, 1] * model.a[1, 1], 1e-12 Pa/m)
