## Session-owned prime fields and exact sparse matrix elimination.
import Rssn_SparseExact as Exact
import Rssn_Modular as Modular

fn fails<T>(value: Result<T, OpError>): Bool =
    match value with
    | Ok(_) -> false
    | Err(_) -> true

test "packed prime context accepts a full-width prime and rejects a composite" =
    match Exact.field(18446744073709551557) with
    | Ok(field) ->
        match Exact.reducer(field) with
        | Ok(reducer) ->
            (Exact.add(field, 18446744073709551615, 18446744073709551608) == Ok(109)
                && Exact.subtract(field, 18446744073709551615, 18446744073709551608) == Ok(7)
                && Exact.batch_inverse(field, [1, 18446744073709551557]) == Ok(None)
                && fails(Exact.field(341))
                && Exact.release_field(field) == Ok(true)
                && Modular.barrett_modulus(reducer) == Ok(18446744073709551557)
                && Modular.release_barrett(reducer) == Ok(true))
        | Err(_) -> false
    | Err(_) -> false

test "rational reduction and RREF expose exact residues and zero-based pivots" =
    match (Exact.rational_from_dense(2, 3, [1 / 2, 0 / 1, -3 / 4, 0 / 1, 2 / 3, 1 / 1]), Exact.field(7)) with
    | (Ok(matrix), Ok(field)) ->
        match Exact.reduce_matrix(matrix, field) with
        | Ok(Some(reduced)) ->
            match Exact.prime_rref(reduced) with
            | Ok(rref) ->
                (Exact.prime_to_dense(reduced) == Ok([[4, 0, 1], [0, 3, 1]])
                    && Exact.prime_to_dense(rref.matrix) == Ok([[1, 0, 2], [0, 1, 5]])
                    && rref.pivots == [0, 1])
            | Err(_) -> false
        | _ -> false
    | _ -> false

test "Dixon shares a factorization and preserves large exact rational answers" =
    let large = 1234567890123456789012345678901234567890123456789012345678901
    match Exact.rational_from_dense(1, 1, [large / 1]) with
    | Ok(matrix) ->
        match Exact.solve_dixon_multi(matrix, [[1 / 1], [large / 1]]) with
        | Ok(Some(solution)) -> solution == [[1 / large], [1 / 1]]
        | _ -> false
    | Err(_) -> false

test "a rational denominator divisible by the prime has no reduction" =
    match (Exact.rational_from_dense(1, 1, [1 / 7]), Exact.field(7)) with
    | (Ok(matrix), Ok(field)) ->
        match Exact.reduce_matrix(matrix, field) with
        | Ok(None) -> true
        | _ -> false
    | _ -> false
