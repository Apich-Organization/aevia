## Exact decimal exchange through the typed multiprecision facade.
import Rssn_Multiprecision as MP

test "decimal text rounds once at a binary halfway point" =
    let text = "1.25000000001"
    match MP.decimal_to_dyadic(text, 2) with
    | Ok(value) -> MP.dyadic_to_decimal(value, 8) == Ok("1.5") && MP.round_decimal_text(text, 2, "nearest") == Ok("1.3")
    | Err(_) -> false

test "decimal interval formatting certifies a unique rounding" =
    match MP.enclose_decimal("0.125", 12) with
    | Ok(interval) -> MP.format_decimal_ball(interval, 3) == Ok("0.125") && MP.decimal_exponent(interval.midpoint) == Ok(Some(-1))
    | Err(_) -> false

test "decimal limits return typed errors" =
    match MP.working_bits_for_decimal_digits(10001) with
    | Err(_) -> true
    | Ok(_) -> false
