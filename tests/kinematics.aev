## Conformance tests for dimensions and arithmetic.
## Run with: cargo run -p aevia-cli -- test tests/kinematics.aev
let g = 9.80665 m/s^2

fn fall_time(h: Float[L]): Float[T] = sqrt(2 * h / g)

test "fall time from 20 m" = approx_eq(fall_time(20.0 m), 2.01962 s, 0.0001 s)

test "scaling the height scales the time by sqrt" = approx_eq(fall_time(80.0 m), 2.0 * fall_time(20.0 m), 0.0001 s)

test "energy is positive" =
    let m = 2.0 kg
    let v = 3.0 m/s
    let e = m * v ^ 2 / 2.0
    e > 0.0 J

test "dimensionless trigonometry" = approx_eq(sin(30.0 deg), 0.5, 1e-12)
