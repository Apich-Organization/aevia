import Rssn_ComplexDynamics as Dynamics

test "escape records distinguish a crossing from iteration exhaustion" =
    match (Dynamics.mandelbrot_escape(complex(0.0, 0.0), 24, 2.0), Dynamics.julia_escape(complex(3.0, 0.0), complex(0.0, 0.0), 24, 2.0)) with
    | (Ok(bounded), Ok(escaping)) -> !bounded.escaped && bounded.steps == 24 && bounded.potential == None && escaping.escaped && escaping.steps == 0
    | _ -> false

test "the superattracting period-two orbit returns to its starting point" =
    match (Dynamics.quadratic_orbit(complex(0.0, 0.0), complex(-1.0, 0.0), 2), Dynamics.quadratic_multiplier(complex(0.0, 0.0), complex(-1.0, 0.0), 2, 1e-12)) with
    | (Ok(points), Ok(result)) -> length(points) == 3 && approx_eq(re(at(points, 1)), -1.0, 1e-12) && approx_eq(re(at(points, 2)), 0.0, 1e-12) && result.kind == "superattracting" && approx_eq(result.residual, 0.0, 1e-12)
    | _ -> false

test "the zero-parameter external ray preserves angle in turns" =
    match Dynamics.external_ray(complex(0.0, 0.0), 0.25, 0.6931471805599453, 8) with
    | Ok(ray) -> approx_eq(re(ray.point), 0.0, 1e-10) && approx_eq(im(ray.point), 2.0, 1e-10) && ray.residual < 1e-10
    | Err(_) -> false
