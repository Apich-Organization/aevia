import Rssn_numerical_callback as Numeric

fn polynomial(z: Complex): Complex = z * z - complex(1.0, 0.0)
fn derivative(z: Complex): Complex = complex(2.0, 0.0) * z
fn contraction(z: Complex): Complex = complex(0.5, 0.0) * z

test "Newton returns a root in the positive basin" =
    match Numeric.num_complex_dynamics_newton_basin_checked_typed(complex(2.0, 0.0), 2.0, 4.0, 1e-12, 32, 64, polynomial, derivative) with
    | Ok(result) ->
        match result.root with
        | Some(root) -> approx_eq(re(root.point), 1.0, 1e-10) && result.evaluations > result.tested
        | None -> false
    | Err(_) -> false

test "Koenigs linearizes the contraction exactly" =
    match Numeric.num_complex_dynamics_koenigs_checked_typed(complex(0.0, 0.0), complex(0.5, 0.0), complex(0.25, 0.0), 1.0, 1e-12, 12, 2, contraction) with
    | Ok(result) -> approx_eq(re(result.coordinate), 0.25, 1e-14) && result.steps == 1 && result.evaluations == 2
    | Err(_) -> false
