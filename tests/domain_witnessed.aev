## The witnessed tier of the domain modules (spec §10.3.8): operators that nobody
## wrote a signature for, typed from what the kernel observed itself doing. The
## wrappers have the same shape as the curated ones, and the same `Result`
## channel checks every answer.
## Run with: cargo run -p aevia-cli -- test tests/domain_witnessed.aev
import Rssn_LinearAlgebra as LA
import Rssn_Calculus as C

fn flag(r: Result<Bool, OpError>): Bool =
    match r with
    | Ok(b) -> b
    | Err(_) -> false

fn int_is(r: Result<Int, OpError>, expected: Int): Bool =
    match r with
    | Ok(v) -> v == expected
    | Err(_) -> false

fn ints_are(r: Result<Tensor<2, Int>, OpError>, expected: Tensor<2, Int>): Bool =
    match r with
    | Ok(v) -> v == expected
    | Err(_) -> false

fn fails<A>(r: Result<A, OpError>): Bool =
    match r with
    | Ok(_) -> false
    | Err(_) -> true

let x = symbol("x")

test "a predicate on an integer matrix is a Bool" =
    flag(LA.is_symmetric([[2, 1], [1, 2]])) && !flag(LA.is_symmetric([[2, 1], [0, 2]]))

test "a Kronecker product of integer matrices is an integer matrix" =
    ints_are(LA.kron([[1, 2], [3, 4]], [[0, 1], [1, 0]]), [[0, 1, 0, 2], [1, 0, 2, 0], [0, 3, 0, 4], [3, 0, 4, 0]])

test "an inverse of an integer matrix has exact rational entries" =
    match LA.inverse([[2, 0], [0, 4]]) with
    | Ok(m) -> m == [[1/2, 0], [0, 1/4]]
    | Err(_) -> false

test "a singular matrix is an Err, not a wrong value" =
    fails(LA.inverse([[1, 2], [2, 4]]))

test "identities of D-finite functions are decided" =
    flag(C.holonomic_zero(sin(x)^2 + cos(x)^2 - 1, x)) && !flag(C.holonomic_zero(sin(x)^2 + cos(x)^2 - 2, x))

test "outside the decidable class the wrapper reports an error" =
    fails(C.holonomic_zero(tan(x), x))

test "a sparse matrix is an opaque handle with typed queries" =
    match LA.sp_from_dense([[2, 0, 0], [0, 3, 0], [1, 0, 4]]) with
    | Ok(s) -> int_is(LA.sp_rank(s), 3) && int_is(LA.sp_nnz(s), 4)
    | Err(_) -> false
