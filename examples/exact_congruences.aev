## Run: aevia test examples/exact_congruences.aev
import Rssn_NumberTheory as N

let congruences = N.crt_general([-1, 5], [6, 8])
let incompatible = N.crt_general([0, 1], [4, 6])

let compatible_solution =
    match congruences with
    | Ok(solution) -> solution == [5, 24]
    | Err(_) -> false

let detects_incompatibility =
    match incompatible with
    | Ok(_) -> false
    | Err(_) -> true

test "compatible congruences with common factors return first and period" = compatible_solution

test "incompatible congruences report an operator error" = detects_incompatibility
