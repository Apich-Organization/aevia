## Compute three displacements in a spring chain.
import Rssn_numerical_matrix as Matrix

let diagonal = [2.0 N/m, 2.0 N/m, 2.0 N/m]

let adjacent = [-1.0 N/m, -1.0 N/m]

let force = [0.0 N, 0.0 N, 4.0 N]

let displacement = Matrix.num_dense_solve_spd_tridiagonal(diagonal, adjacent, force)

fn main(): IO Unit = do
    println("Displacements: {displacement}")

test "the three displacements have length units" = approx_eq(displacement[0], 1.0 m, 1e-12 m) && approx_eq(displacement[1], 2.0 m, 1e-12 m) && approx_eq(displacement[2], 3.0 m, 1e-12 m)

test "the last spring equation balances the applied force" = approx_eq(diagonal[2] * displacement[2] + adjacent[1] * displacement[1], force[2], 1e-12 N)
