## Evaluate measured sampled characteristic data at ordered field points.
import Rssn_numerical_vector as Native

let rho = [1.0 m, 1.4 m, 2.0 m, 3.0 m]
let sigma = [-0.5 m, -0.15 m, 0.3 m, 0.95 m]
let first_trace = [0.5 s, 0.9 s, 1.5 s, 2.5 s]
let second_trace = [0.5 s, 0.85 s, 1.3 s, 1.95 s]

test "sampled Goursat solves measured interior and characteristic queries" =
    let targets = [[2.4 m, 0.6 m], [1.0 m, 0.2 m], [2.1 m, -0.5 m]]
    let values: Tensor<1, Float[Time]> = Native.num_native_epd_goursat_samples(1.5, rho, first_trace, sigma, second_trace, targets)
    let interior = approx_eq(at(values, 0), 3.0 s, 1e-9 s)
    let vertical = approx_eq(at(values, 1), 1.2 s, 1e-9 s)
    let horizontal = approx_eq(at(values, 2), 1.6 s, 1e-9 s)
    interior && vertical && horizontal

test "sampled Goursat rejects mismatched field dimensions at runtime" =
    let wrong_trace = [0.5 m, 0.85 m, 1.3 m, 1.95 m]
    match Rssn.dynamic("num_native_epd_goursat_samples", [to_value(1.5), to_value(rho), to_value(first_trace), to_value(sigma), to_value(wrong_trace), to_value([[2.4 m, 0.6 m]])]) with
    | Err(_) -> true
    | Ok(_) -> false

test "sampled Goursat rejects targets with three coordinates" =
    match Rssn.dynamic("num_native_epd_goursat_samples", [to_value(1.5), to_value(rho), to_value(first_trace), to_value(sigma), to_value(second_trace), to_value([[2.4 m, 0.6 m, 0.0 m]])]) with
    | Err(_) -> true
    | Ok(_) -> false
