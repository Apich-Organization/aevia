## Work with the named coordinates and branches returned by Rssn_Special.
import Rssn_Special as Special

let point = complex(2.0, 0.5)

let projection = Special.riemann_sphere_project(point)

let branches = Special.joukowsky_inverse(point)

test "the stereographic coordinates invert on the unit sphere" =
    match projection with
    | Ok(p) ->
        match Special.riemann_sphere_unproject(p.x, p.y, p.z) with
        | Ok(Some(restored)) -> approx_eq(magnitude(restored - point), 0.0, 1e-12)
        | _ -> false
    | Err(_) -> false

fn main(): IO Unit = do
    match projection with
    | Ok(p) -> println("Sphere coordinates: ({p.x}, {p.y}, {p.z})")
    | Err(error) -> println("Projection failed: {error}")
    match branches with
    | Ok(pair) -> println("Inverse Joukowsky branches: {pair.plus}, {pair.minus}")
    | Err(error) -> println("Inverse map failed: {error}")
