## Run: cargo run -p aevia-cli -- test examples/pde_adaptive_advanced.aev
## These assertions control temporal error on a fixed spatial discretization.
import Rssn_numerical_callback as N

let control = { t0 = 0.0 s, t1 = 0.2 s, rtol = 0.000001, atol = 0.000000001 m, h0 = 0.2 s, h_min = 0.000000001 s, h_max = 0.2 s, max_steps = 100000, max_rejections = 1000, max_step_calls = 1000000, max_evaluations = 1000000 }

let periodic = { kind = [3], value = [0.0 m], flux = [0.0], alpha = [0.0], beta = [1.0 m], gamma = [0.0 m] }

let insulating = { kind = [1], value = [0.0 m], flux = [0.0], alpha = [0.0], beta = [1.0 m], gamma = [0.0 m] }

fn flux(u: Float[Length]): Float[Length^2/Time] = u * 1.0 m/s

fn wave_speed(u: Float[Length]): Float[Length/Time] = 1.0 m/s

fn reaction(t: Float[Time], u: Tensor<1, Float[Length]>): Tensor<1, Float[Length/Time]> = u / 1.0 s

test "FEM be adapts time on the existing finite element mesh" =
    let r = N.num_pde_fem_be_adaptive([4], [0.0 m], [1.0 m], 1, 1.0 m^2/s, 1.0 Hz, [1.0 m, 1.0 m, 1.0 m, 1.0 m, 1.0 m], insulating, control)
    approx_eq(at(at(r.states, length(r.times) - 1), 2), exp(-0.2) * 1.0 m, 0.002 m)

test "FEM cn adapts time on the existing finite element mesh" =
    let r = N.num_pde_fem_cn_adaptive([4], [0.0 m], [1.0 m], 1, 1.0 m^2/s, 1.0 Hz, [1.0 m, 1.0 m, 1.0 m, 1.0 m, 1.0 m], insulating, control)
    approx_eq(at(at(r.states, length(r.times) - 1), 2), exp(-0.2) * 1.0 m, 0.002 m)

test "FVM upwind preserves a periodic constant state" =
    match N.num_pde_fvm_upwind_adaptive_typed(1.0 m, map(fn (_: Int) => 1.0 m, range(0, 8)), true, control, flux, wave_speed) with
    | Ok(r) -> all(fn (v: Float[Length]) => approx_eq(v, 1.0 m, 0.000001 m), flatten(r.states))
    | Err(_) -> false

test "FVM lax_friedrichs preserves a periodic constant state" =
    match N.num_pde_fvm_lax_friedrichs_adaptive_typed(1.0 m, map(fn (_: Int) => 1.0 m, range(0, 8)), true, control, flux, wave_speed) with
    | Ok(r) -> all(fn (v: Float[Length]) => approx_eq(v, 1.0 m, 0.000001 m), flatten(r.states))
    | Err(_) -> false

test "FVM muscl_minmod preserves a periodic constant state" =
    match N.num_pde_fvm_muscl_minmod_adaptive_typed(1.0 m, map(fn (_: Int) => 1.0 m, range(0, 8)), true, control, flux, wave_speed) with
    | Ok(r) -> all(fn (v: Float[Length]) => approx_eq(v, 1.0 m, 0.000001 m), flatten(r.states))
    | Err(_) -> false

test "FVM muscl_van_leer preserves a periodic constant state" =
    match N.num_pde_fvm_muscl_van_leer_adaptive_typed(1.0 m, map(fn (_: Int) => 1.0 m, range(0, 8)), true, control, flux, wave_speed) with
    | Ok(r) -> all(fn (v: Float[Length]) => approx_eq(v, 1.0 m, 0.000001 m), flatten(r.states))
    | Err(_) -> false

test "DG retains SSPRK3 while adapting time" =
    let r = N.num_pde_dg_adaptive(1.0 m, 2, 2, 1.0 m/s, [1.0 m, 1.0 m, 1.0 m, 1.0 m, 1.0 m, 1.0 m], control)
    all(fn (v: Float[Length]) => approx_eq(v, 1.0 m, 0.000001 m), flatten(r.states))

test "Fourier ETDRK4 uses physical callback time and field rate" =
    match N.num_pde_spectral_etdrk4_adaptive_typed([4], [4.0 m], 0.0 m^2/s, 0.0 Hz, [1.0 m, 1.0 m, 1.0 m, 1.0 m], control, reaction) with
    | Ok(r) -> approx_eq(at(at(r.states, length(r.times) - 1), 0), exp(0.2) * 1.0 m, 0.0001 m)
    | Err(_) -> false

fn nodal_source(t: Float[Time], coordinates: Tensor<2, Float[Length]>): Tensor<1, Float[Length/Time]> = map(fn (_: Int) => (1.0 + (t / 1.0 s) ^ 2) * 1.0 m/s, range(0, at(shape(coordinates), 0)))

test "nonzero FEM source keeps its physical times and rate dimensions" =
    match N.num_pde_fem_cn_source_adaptive_typed([4], [0.0 m], [1.0 m], 1, 1.0 m^2/s, 0.0 Hz, [0.0 m, 0.0 m, 0.0 m, 0.0 m, 0.0 m], insulating, control, nodal_source) with
    | Ok(r) -> approx_eq(at(at(r.states, length(r.times) - 1), 2), (0.2 + 0.2 ^ 3 / 3.0) * 1.0 m, 0.0001 m) && r.evaluations > 0
    | Err(_) -> false

test "FEM source callback budget is enforced" =
    let limited = { control with max_evaluations = 1 }
    match N.num_pde_fem_cn_source_adaptive_typed([4], [0.0 m], [1.0 m], 1, 1.0 m^2/s, 0.0 Hz, [0.0 m, 0.0 m, 0.0 m, 0.0 m, 0.0 m], insulating, limited, nodal_source) with
    | Ok(_) -> false
    | Err(_) -> true

test "native two-dimensional DG adapts SSPRK3 without flattening the mesh" =
    let r = N.num_pde_dg_nd_adaptive([2, 2], [1.0 m, 1.0 m], 2, [1.0 m/s, 0.3 m/s], map(fn (_: Int) => 1.0 m, range(0, 36)), control)
    all(fn (v: Float[Length]) => approx_eq(v, 1.0 m, 0.000001 m), flatten(r.states)) && at(shape(r.coordinates), 0) == 36
