## Native particle, continuum and quantum entry points with checked unit contracts.
## Run: cargo run -p aevia-cli -- test examples/native_particle_engines.aev
fn native(name: String, args: Tensor<1, Value>): Option<Value> =
    match Rssn.dynamic(name, args) with
    | Ok(value) -> Some(value)
    | Err(_) -> None

test "native dimension generic MD box preserves exact geometric volume" =
    match native("num_native_md_normalized_frame", []) with
    | Some(frame) ->
        match native("num_native_engine_box_periodic_d3", [frame, to_value([2.0, 3.0, 4.0])]) with
        | Some(box) ->
            match native("num_native_engine_box_volume_d3", [box]) with
            | Some(value) ->
                match from_value<Float>(value) with
                | Ok(volume) -> volume == 24.0
                | Err(_) -> false
            | None -> false
        | None -> false
    | None -> false

test "classical particle energy retains SI mass length time dimensions" =
    match native("num_native_classical_particle_new", [to_value(2.0 kg), to_value([0.0 m, 0.0 m, 0.0 m]), to_value([3.0 m/s, 0.0 m/s, 0.0 m/s])]) with
    | Some(particle) ->
        match native("num_native_classical_particle_kinetic_energy", [particle]) with
        | Some(value) ->
            match from_value<Float[Mass*Length^2/Time^2]>(value) with
            | Ok(energy) -> approx_eq(energy, 9.0 J, 1e-12 J)
            | Err(_) -> false
        | None -> false
    | None -> false

test "native multigrid maps its unit domain to physical references" =
    match native("num_native_mtm_solve_poisson_1d_multigrid", [to_value(3), to_value([2.0 K/m^2, 2.0 K/m^2, 2.0 K/m^2]), to_value(20), to_value(2.0 m), to_value(3.0 K)]) with
    | Some(value) ->
        match from_value<{ solution: Tensor<1, Float[Temperature]>, shape: Tensor<1, Int>, domain_reference: Float[Length] }>(value) with
        | Ok(result) -> result.shape == [5] && approx_eq(at(result.solution, 2), 1.0 K, 1e-8 K)
        | Err(_) -> false
    | None -> false

test "native GPE density has inverse area units and unit normalization" =
    match native("num_native_gpe_run_ground_state", [to_value([4, 4]), to_value([2.0 m, 2.0 m]), to_value(1.0 kg), to_value(1.0 m), to_value(1e32 s), to_value(2), to_value(0.0 J*m^2), to_value(0.0 J/m^2)]) with
    | Some(value) ->
        match from_value<Tensor<2, Float[Length^-2]>>(value) with
        | Ok(density) -> approx_eq(density[0, 0], 0.25 m^-2, 1e-12 m^-2)
        | Err(_) -> false
    | None -> false

test "native split step uses explicit normalized coordinates when requested" =
    match native("num_native_split_centered_normalized", [to_value([4]), to_value([2.0]), to_value(1.0)]) with
    | Some(solver) ->
        match native("num_native_split_norm2", [solver, to_value([1.0, 1.0, 1.0, 1.0])]) with
        | Some(value) ->
            match from_value<Float>(value) with
            | Ok(norm) -> approx_eq(norm, 2.0, 1e-12)
            | Err(_) -> false
        | None -> false
    | None -> false
