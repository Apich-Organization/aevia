## The generated RSSN distribution interface returns checked scalar probabilities.
import Rssn_stats as Stats
open Units.SI

test "normal lower tails can be used as dimensionless floats" =
    match Stats.normal([to_value(0.0), to_value(1.0)]) with
    | Ok(distribution) ->
        match Stats.cdf([distribution, to_value(-10.0)]) with
        | Ok(probability) ->
            match from_value<Float>(probability) with
            | Ok(p) -> approx_eq(p / 7.619853024160526e-24, 1.0, 3e-13)
            | Err(_) -> false
        | Err(_) -> false
    | Err(_) -> false

test "a time point is incompatible with a unitless distribution" =
    match Stats.normal([to_value(0.0), to_value(1.0)]) with
    | Ok(distribution) ->
        match Stats.cdf([distribution, to_value(1.0 s)]) with
        | Ok(_) -> false
        | Err(_) -> true
    | Err(_) -> false

test "the native distribution route also checks measured points" =
    let parameters = { mu = 0.0, sigma = 1.0 }
    match Rssn.dynamic("num_native_distribution_new", [to_value("Normal"), to_value(parameters), to_value(2.0 m)]) with
    | Ok(distribution) ->
        let measured = Rssn.dynamic("num_native_distribution_cdf", [distribution, to_value(-20.0 m)])
        let incompatible = Rssn.dynamic("num_native_distribution_cdf", [distribution, to_value(-20.0 s)])
        match (measured, incompatible) with
        | (Ok(result), Err(_)) ->
            match from_value<Float>(result) with
            | Ok(p) -> approx_eq(p / 7.619853024160526e-24, 1.0, 3e-13)
            | Err(_) -> false
        | _ -> false
    | Err(_) -> false
