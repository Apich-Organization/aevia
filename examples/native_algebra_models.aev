## Portable native Matrix, Polynomial, and approximation objects.
## Run: bazel run //:aevia -- test examples/native_algebra_models.aev
import Rssn_numerical_matrix as M

import Rssn_numerical_vector as V

import Rssn_numerical_callback as C

test "fused native regression returns measured loss and gradient" =
    let data = [to_value([[2.0 s], [4.0 s], [6.0 s]]), to_value([8.0 m, 12.0 m, 16.0 m]), to_value(2.0 s), to_value(4.0 m)]
    match Rssn.dynamic("num_analysis_linear_regression_new", data) with
    | Ok(model) ->
        let coefficients = to_value([to_value(0.0 m), to_value(2.0 m/s)])
        match Rssn.dynamic("num_analysis_regression_value_and_gradient", [model, coefficients]) with
        | Ok(value) ->
            match from_value<{ value: Float[Length^2], gradient: Tensor<1, Value> }>(value) with
            | Ok(result) ->
                match (from_value<Float[Length]>(result.gradient[0]), from_value<Float[Length*Time]>(result.gradient[1])) with
                | (Ok(intercept), Ok(slope)) -> approx_eq(result.value, 8.0 m^2, 1e-12 m^2) && approx_eq(intercept, -4.0 m, 1e-12 m) && approx_eq(slope, -16.0 m*s, 1e-12 m*s)
                | _ -> false
            | Err(_) -> false
        | Err(_) -> false
    | Err(_) -> false

let a = M.num_matrix_float_new([[1.0 m, 2.0 m], [3.0 m, 4.0 m]], 0)

let changed = M.num_matrix_float_get_mut(a, 0, 0, 5.0 m)

let determinant = M.num_matrix_float_determinant(a)

let transposed = M.num_matrix_float_transpose(a)

let decomposition = M.num_matrix_float_decompose_qr(a)

test "native matrix methods preserve physical entries and immutable updates" = approx_eq(M.num_matrix_float_get(changed, 0, 0), 5.0 m, 1e-12 m) && approx_eq(M.num_matrix_float_get(a, 0, 0), 1.0 m, 1e-12 m) && approx_eq(M.num_matrix_float_trace(a), 5.0 m, 1e-12 m) && approx_eq(at(at(transposed.entries, 0), 1), 3.0 m, 1e-12 m)

test "determinant encodes the physical matrix-order power explicitly" = determinant.order == 2 && approx_eq(determinant.normalized, -2.0, 1e-12) && approx_eq(determinant.entry_unit, 1.0 m, 1e-12 m)

test "inverse native Option contains inverse entry dimensions" =
    match M.num_matrix_float_inverse(a) with
    | Some(inverse) -> approx_eq(M.num_matrix_float_get(inverse, 0, 0), -2.0 m^-1, 1e-12 m^-1)
    | None -> false

let exact_entries: Tensor<2, Real[Length]> = [[1 m, 1 m, 0 m], [1 m, 1 m, 1 m], [0 m, 1 m, 0 m]]

let exact = M.num_matrix_real_new(exact_entries, 0)

let exact_det = M.num_matrix_real_determinant_lu(exact)

let tiny: Tensor<2, Real[Length]> = [[1e-40 m, 0 m], [0 m, 1e-40 m]]

test "exact generic matrix pivoting preserves rational arithmetic and tiny pivots" = decide(exact_det.normalized == -1) == Some(true) && M.num_matrix_real_rank(M.num_matrix_real_new(tiny, 0)) == 2

let p = V.num_polynomial_model_new([1.0 s, 0.0 s, -4.0 s], 2.0 m)

let dp = V.num_polynomial_model_derivative(p)

let integral = V.num_polynomial_model_integral(p)

let roots = V.num_polynomial_model_find_roots(p)

test "normalized polynomials restore physical derivative and integral powers" = approx_eq(V.num_polynomial_model_eval(p, 4.0 m), 0.0 s, 1e-10 s) && approx_eq(V.num_polynomial_model_eval(dp, 4.0 m), 2.0 s/m, 1e-10 s/m) && approx_eq(V.num_polynomial_model_eval(integral, 4.0 m), -32.0 / 3.0 * 1.0 m*s, 1e-9 m*s) && any(fn (x: Float[Length]) => approx_eq(x, 4.0 m, 1e-7 m), roots)

test "checked polynomial division preserves a finite measured remainder" =
    let dividend = V.num_polynomial_model_new([2.0 s, 1.7976931348623157e308 s], 1.0 m)
    let divisor = V.num_polynomial_model_new([0.0 kg, 1.0 kg, 1.7976931348623157e308 kg], 1.0 m)
    let result = V.num_polynomial_model_try_long_division(dividend, divisor)
    let quotient = V.num_polynomial_model_eval(result.quotient, 0.0 m)
    let remainder = V.num_polynomial_model_eval(result.remainder, 0.0 m)
    quotient == 2.0 s/kg && remainder == -1.7976931348623157e308 s

let spline = V.num_native_cubic_spline_new([0.0 s, 1.0 s, 2.0 s], [0.0 m, 1.0 m, 4.0 m], 1, 0.0 m/s, 4.0 m/s)

let pchip = V.num_native_pchip_new([0.0 s, 1.0 s, 2.0 s], [0.0 m, 2.0 m, 4.0 m])

let cheb = V.num_native_cheb_coefficients([1.0 m, 2.0 m], 0.0 s, 2.0 s)

let cheb_roots = V.num_native_cheb_roots(cheb)

test "native spline and PCHIP methods keep independent axis and ordinate units" = approx_eq(V.num_native_cubic_spline_eval(spline, 0.5 s), 0.25 m, 1e-10 m) && approx_eq(V.num_native_cubic_spline_d1(spline, 0.5 s), 1.0 m/s, 1e-10 m/s) && approx_eq(V.num_native_cubic_spline_integrate(spline, 0.0 s, 2.0 s), 8.0 / 3.0 * 1.0 m*s, 1e-9 m*s) && approx_eq(V.num_native_pchip_derivative(pchip, 0.5 s), 2.0 m/s, 1e-10 m/s)

test "native Chebyshev models expose linear roots without indexing past the matrix" = V.num_native_cheb_degree(cheb) == 1 && approx_eq(at(cheb_roots, 0), 0.5 s, 1e-9 s) && approx_eq(V.num_native_cheb_definite_integral(cheb), 2.0 m*s, 1e-10 m*s)

fn square(t: Float[Time]): Float[Length] = (t / 1.0 s) ^ 2 * 1.0 m

test "generic native approximation constructors invoke checked live callbacks" =
    match C.num_native_cheb_from_fn_typed(0.0 s, 2.0 s, 4, 32, square) with
    | Ok(series) -> approx_eq(V.num_native_cheb_eval(series, 1.5 s), 2.25 m, 1e-9 m)
    | Err(_) -> false

test "generic native adaptive approximation controls its callback budget" =
    match C.num_native_cheb_adaptive_typed(0.0 s, 2.0 s, 1e-9, 16, 4, square) with
    | Ok(_) -> false
    | Err(_) -> true

let dense_factor = M.num_dense_lu_model_build([[2.0 m, 0.0 m], [0.0 m, 4.0 m]])

let dense_solution = M.num_dense_lu_model_solve(dense_factor, [6.0 s, 8.0 s])

let sparse_matrix = M.num_csr_model_from_triplets(2, 2, [0, 1], [0, 1], [2.0 m, 4.0 m])

let sparse_factor = M.num_sparse_lu_model_build(sparse_matrix)

let sparse_solution = M.num_sparse_lu_model_solve(sparse_factor, [6.0 s, 8.0 s])

let preconditioner = M.num_sparse_ilu_model_build(sparse_matrix)

let preconditioned = M.num_sparse_ilu_model_apply(preconditioner, [6.0 s, 8.0 s])

test "portable native dense and sparse factors preserve quotient units" = approx_eq(at(dense_solution, 0), 3.0 s/m, 1e-10 s/m) && approx_eq(at(sparse_solution, 1), 2.0 s/m, 1e-10 s/m) && approx_eq(at(preconditioned, 0), 3.0 s/m, 1e-10 s/m) && M.num_sparse_lu_model_dim(sparse_factor) == 2

test "native CSR methods keep numerical data distinct from dimensionless topology" = approx_eq(at(M.num_csr_model_diagonal(sparse_matrix), 0), 2.0 m, 1e-12 m) && approx_eq(at(M.num_csr_model_matvec(sparse_matrix, [1.0 s, 2.0 s]), 1), 8.0 m*s, 1e-12 m*s) && M.num_csr_model_bandwidth(sparse_matrix) == 0
