## Run: aevia test examples/native_ode_objects.aev
## Native tapes operate on normalized coordinates. Explicit positive references
## restore independently measured position and velocity, rather than placing
## incompatible physical components in a homogeneous numeric tensor.
open Units.SI

import Rssn_numerical_vector as N

let empty_strings: Tensor<1, String> = []

let empty_values: Tensor<1, Value> = []

let tape = unwrap_or(N.num_native_tape_lower([to_value(["v", "-q"]), to_value(["t", "q", "v"]), to_value(empty_strings), to_value([to_value(1.0 s), to_value(1.0 m), to_value(1.0 m / s)]), to_value(empty_values), to_value([to_value(1.0 m / s), to_value(1.0 m / s / s)])]), to_value(0))

let rhs = unwrap_or(N.num_analysis_ode_rhs_new([tape, to_value(empty_values)]), to_value(0))

let initial = to_value([to_value(1.0 m), to_value(0.0 m / s)])

let options = to_value({ rtol = 1e-7, atol = 1e-9, h0 = 0.01 s, hmin = 0.0 s, hmax = 0.1 s, max_steps = 2000 })

let no_events = to_value(empty_values)

let fixed = unwrap_or(N.num_analysis_ode_fixed([rhs, initial, to_value(0.0 s), to_value(1.0 s), options, to_value([32, 2]), no_events, to_value(500)]), to_value(0))

test "native mixed state preserves position and velocity domains" =
    match N.num_analysis_ode_last([fixed]) with
    | Ok(value) ->
        match from_value<Tensor<1, Value>>(value) with
        | Ok(y) ->
            match from_value<Float[Length]>(y[0]) with
            | Ok(q) -> q > 0.5402 m && q < 0.5404 m
            | Err(_) -> false
        | Err(_) -> false
    | Err(_) -> false

test "native fixed final state avoids retaining trajectory samples" =
    let args = [rhs, initial, to_value(0.0 s), to_value(1.0 s), to_value(24000), to_value(0), to_value(24000)]
    match N.num_analysis_ode_fixed_final(args) with
    | Ok(value) ->
        match from_value<Tensor<1, Value>>(value) with
        | Ok(y) ->
            match (from_value<Float[Length]>(y[0]), from_value<Float[Length / Time]>(y[1])) with
            | (Ok(q), Ok(v)) -> approx_eq(q, 0.540302305868 m, 2e-5 m) && approx_eq(v, -0.841470984808 m/s, 2e-5 m/s)
            | _ -> false
        | Err(_) -> false
    | Err(_) -> false

test "checked explicit Euler shortens its last measured step" =
    let args = [rhs, initial, to_value(0.0 s), to_value(1.0 s), to_value(0.6 s), to_value("Forward"), to_value(2)]
    match Rssn.dynamic("num_analysis_physics_explicit_euler", args) with
    | Ok(value) ->
        match from_value<Tensor<1, Value>>(value) with
        | Ok(rows) ->
            match from_value<{ time: Float[Time], state: Tensor<1, Value> }>(rows[2]) with
            | Ok(last) ->
                match (from_value<Float[Length]>(last.state[0]), from_value<Float[Length/Time]>(last.state[1])) with
                | (Ok(q), Ok(v)) -> last.time == 1.0 s && approx_eq(q, 0.76 m, 1e-12 m) && approx_eq(v, -1.0 m/s, 1e-12 m/s)
                | _ -> false
            | Err(_) -> false
        | Err(_) -> false
    | Err(_) -> false

test "native rate budget errors survive the adapter" =
    match N.num_analysis_ode_fixed([rhs, initial, to_value(0.0 s), to_value(1.0 s), options, to_value([32, 2]), no_events, to_value(1)]) with
    | Ok(_) -> false
    | Err(_) ->
        ## Release the trajectory, RHS and tape when finished with them.
        ## Session objects count against the memory budget until released.
        match Rssn.dynamic("num_native_release", [fixed]) with
        | Ok(_) ->
            match Rssn.dynamic("num_native_release", [rhs]) with
            | Ok(_) ->
                match Rssn.dynamic("num_native_release", [tape]) with
                | Ok(_) -> true
                | Err(_) -> false
            | Err(_) -> false
        | Err(_) -> false

fn main(): IO Unit = println("Native ODE objects preserve independent physical references")

test "sampled symplectic splitting keeps the initial and final step" =
    let force = unwrap_or(N.num_native_tape_lower([to_value(["-q"]), to_value(["q"]), to_value(empty_strings), to_value([to_value(1.0 m)]), to_value(empty_values), to_value([to_value(1.0 m / s / s)])]), to_value(0))
    let acceleration = unwrap_or(Rssn.dynamic("num_analysis_mechanics_acceleration_new", [force, to_value(empty_values), to_value(1.0 s)]), to_value(0))
    match Rssn.dynamic("num_analysis_symplectic_integrate_sampled", [acceleration, initial, to_value(-0.1 s), to_value(5), to_value("Verlet"), to_value(2), to_value(30)]) with
    | Ok(value) ->
        match from_value<{steps: Tensor<1, Int>, states: Value}>(value) with
        | Ok(samples) -> samples.steps == [0, 2, 4, 5]
        | Err(_) -> false
    | Err(_) -> false

test "Brent returns the final coordinate bracket in the callback's input unit" =
    let arguments = [to_value(0.0 m), to_value(4.0 m), to_value(1e-12 m), to_value(32)]
    let residual = to_callback(fn (position: Float[Length]) => (position / (1.0 m) - 2.0) * (1.0 s))
    match Rssn.call_ho("num_brent_with_bracket", arguments, [residual]) with
    | Ok(value) ->
        match from_value<{ root: Float[Length], bracket: Tensor<[2], Float[Length]>, evaluations: Int }>(value) with
        | Ok(result) -> approx_eq(result.root, 2.0 m, 1e-12 m) && result.bracket == [2.0 m, 2.0 m] && result.evaluations == 3
        | Err(_) -> false
    | Err(_) -> false

test "diagonal ETDRK4 resolves a small measured stiff equilibrium" =
    let t_refs = to_value([to_value(1.0 s), to_value(1.0 m)])
    let n_refs = to_value([to_value(1.0 m/s)])
    let affine_tape = unwrap_or(Rssn.dynamic("num_native_tape_lower", [to_value(["1.0"]), to_value(["t", "y"]), to_value(empty_strings), t_refs, no_events, n_refs]), to_value(0))
    let nonlinear = unwrap_or(Rssn.dynamic("num_analysis_ode_rhs_new", [affine_tape, no_events]), to_value(0))
    let diagonal = to_value([-1e120 / (1.0 s)])
    let start = to_value([to_value(0.0 m)])
    match Rssn.dynamic("num_analysis_ode_etdrk4_diag", [nonlinear, diagonal, start, to_value(0.0 s), to_value(1.0 s), to_value(1), to_value(4)]) with
    | Ok(value) ->
        match from_value<Tensor<1, Value>>(value) with
        | Ok(rows) ->
            match from_value<Tensor<1, Value>>(rows[1]) with
            | Ok(state) ->
                match from_value<Float[Length]>(state[0]) with
                | Ok(endpoint) -> approx_eq(endpoint, 1e-120 m, 1e-134 m)
                | Err(_) -> false
            | Err(_) -> false
        | Err(_) -> false
    | Err(_) -> false
