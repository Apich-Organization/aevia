## Fit distance against calibrated time, then evaluate a batch of recorded times.
import Rssn_numerical_vector as Numeric

let recorded_times = [1.0 s, 2.0 s, 3.0 s]

let clock = Numeric.num_polynomial_model_new([2.0 s, -1.0 s], 2.0 s)

let trajectory = Numeric.num_polynomial_model_interpolate_lagrange([0.0 s, 2.0 s, 4.0 s], [1.0 m, 5.0 m, 17.0 m], 2.0 s)

let calibrated_trajectory = Numeric.num_polynomial_model_compose(trajectory, clock)

let distances = Numeric.num_polynomial_model_eval_batch(calibrated_trajectory, recorded_times)

fn main(): IO Unit = do
    println("Recorded times: {recorded_times}")
    println("Predicted distances: {distances}")
