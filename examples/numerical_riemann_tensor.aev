import Rssn_numerical_vector as Native

fn sphere_metric(x: Tensor<1, Float[Length]>): Tensor<2, Float[Temperature]> =
    let s = sin(at(x, 0) / (2.0 m))
    [[3.0 K, 0.0 K], [0.0 K, s * s * (3.0 K)]]

test "Riemann curvature restores inverse squared coordinate units" =
    let point = [3.141592653589793 m, 0.4 m]
    let args = [to_value(point), to_value(2.0 m), to_value(3.0 K), to_value(128)]
    match Native.num_native_geometry_riemann_tensor(args, [to_callback(sphere_metric)]) with
    | Ok(value) ->
        match from_value<Tensor<4, Float[Length^-2]>>(value) with
        | Ok(tensor) ->
            let forward = approx_eq(tensor[0, 1, 0, 1], 0.25 m^-2, 1e-7 m^-2)
            let reverse = approx_eq(tensor[0, 1, 1, 0], -0.25 m^-2, 1e-7 m^-2)
            forward && reverse && tensor[0, 1, 0, 0] == 0.0 m^-2
        | Err(_) -> false
    | Err(_) -> false
