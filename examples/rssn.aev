## The kernel's own operators, reached through the generated `Rssn` module.
##
## `Rssn.<name>` is typed from the Kernel Manifest: the checker reads the
## signature, the runtime pins the overload. `Rssn.dynamic` is the escape hatch
## for an operator that has no signature at all.
fn main(): IO Unit = do
    println("kernel       = {Rssn.Version}")
    println("sin(0.5)     = {Rssn.sin(0.5)}")
    println("det          = {Rssn.det([[1.0, 2.0], [3.0, 4.0]])}")

    let name = "sqrt"
    println("overloads    = {Rssn.overloads(name)}")

    let answer = Rssn.dynamic("cos", [to_value(0.0)])
    match answer with
    | Ok(v) -> println("dynamic cos  = {v}")
    | Err(e) -> println("dynamic cos  = failed: {e}")
