module Tensors

## Rank, shape and element dimension all come from the literal; `@` dispatches
## on rank (§3.5.3a).
let m = [[1.0, 2.0], [3.0, 4.0]]

let v = [5.0, 6.0]

fn main(): IO Unit = do
    let p = m @ v
    println("M @ v = {p}")
    println("sum   = {sum(v)}")
    println("mean  = {mean(v)}")
    println("norm  = {norm(v)}")
    println("shape = {shape(m)}")
