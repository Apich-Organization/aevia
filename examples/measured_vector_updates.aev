## Update measured positions with travel time and an optional load correction.
import Rssn_numerical_vector as Numeric

let durations = [1.0 s, 3.0 s, 4.0 s]

let positions = [5.0 m, 7.0 m, 8.0 m]

let updated = Numeric.num_vector_axpy(2.0 m/s, durations, positions)

let load_corrections = [2.0 kg, 4.0 kg, 6.0 kg]

let combined = Numeric.num_vector_axpby(2.0 m/s, durations, 0.5 m/kg, load_corrections)

fn main(): IO Unit = do
    println("Original positions: {positions}")
    println("Updated positions:  {updated}")
    println("With load correction: {positions + combined}")
