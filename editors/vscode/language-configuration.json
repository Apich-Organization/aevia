{
  "comments": {
    "lineComment": "#",
    "blockComment": ["#-", "-#"]
  },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "#-", "close": " -#", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "(=|->|=>|<-|\\bthen|\\belse|\\bdo|\\bwith|\\bwhere)\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*##.*$",
      "action": { "indent": "none", "appendText": "## " }
    }
  ],
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_'₀-₉]*|-?[0-9][0-9_]*(\\.[0-9_]+)?",
  "folding": {
    "offSide": true,
    "markers": { "start": "^\\s*#region\\b", "end": "^\\s*#endregion\\b" }
  }
}
