## `Sde` of §8.9.1/§8.20: the stochastic differential-equation surface.
##
## The chapter's names (`sdeint_diag`, `sdeint_general`, `wiener`, `sde_order`,
## `sde_ensemble_seed`) are global builtins; this module re-exports them so
## `import Sde { sdeint_diag }` resolves, and it declares the §8.9.1 option
## ADTs a program constructs (`SdeMethod`, `SdeStructure`, the two policy
## records and `SdeOpts`).
##
## Hand-written, not generated: the alias-only generator cannot emit an ADT,
## and these constructors are the part of the surface a program must be able to
## *write*. Every field is explicit (a seed and a step are not guessable); the
## runtime validates the record and answers `E0802`/`E1001` for a malformed or
## unavailable combination rather than filling anything in. The result type
## `SdePath<s>` is not declared here: a program reads its fields by inference,
## and its time dimension is the one of `t0`.
module Sde

type SdeMethod =
    | EulerMaruyama
    | Milstein
    | MilsteinStratonovich
    | HeunStratonovich
    | SrkPlaten
    | MilsteinNoncommutative

type SdeStructure =
    | Diagonal
    | General(Int)
    | GeneralNoncommutative(Int)

type SdeFixedOpts<T> = {
    structure: SdeStructure,
    method: SdeMethod,
    seed: Int,
    t0: Float[T],
    dt: Float[T],
    steps: Int,
    terms: Int,
}

type SdeAdaptiveOpts<T> = {
    structure: SdeStructure,
    method: SdeMethod,
    seed: Int,
    t0: Float[T],
    t1: Float[T],
    rtol: Float[1],
    atol: Float[1],
    max_steps: Int,
    cells: Int,
    terms: Int,
}

type SdeOpts<T> =
    | Fixed(SdeFixedOpts<T>)
    | Adaptive(SdeAdaptiveOpts<T>)

let sdeint_diag = sdeint_diag
let sdeint_general = sdeint_general
let wiener = wiener
let sde_order = sde_order
let sde_ensemble_seed = sde_ensemble_seed
