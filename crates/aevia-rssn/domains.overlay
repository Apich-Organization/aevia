sig num_linear_sparse_exact_field_add as add(field: PrimeField, left: Int, right: Int) -> Result<Int, OpError>
sig num_linear_sparse_exact_field_sub as subtract(field: PrimeField, left: Int, right: Int) -> Result<Int, OpError>
sig num_linear_sparse_exact_field_mul as multiply(field: PrimeField, left: Int, right: Int) -> Result<Int, OpError>
sig num_linear_sparse_exact_field_pow as power(field: PrimeField, base: Int, exponent: Int) -> Result<Int, OpError>
sig num_linear_sparse_exact_field_inv as inverse(field: PrimeField, value: Int) -> Result<Option<Int>, OpError>
sig num_linear_sparse_exact_field_reduce as reduce(field: PrimeField, value: Int) -> Result<Int, OpError>
sig num_linear_sparse_exact_field_batch_inv as batch_inverse(field: PrimeField, values: Tensor<1, Int>) -> Result<Option<Tensor<1, Int>>, OpError>
sig num_linear_rational_sparse_from_dense as rational_from_dense(rows: Int, cols: Int, values: Tensor<1, Real>) -> Result<RationalSparse, OpError>
sig num_linear_rational_sparse_to_dense as rational_to_dense(matrix: RationalSparse) -> Result<RationalDense, OpError>
sig num_linear_sparse_exact_rational_to_prime as reduce_matrix(matrix: RationalSparse, field: PrimeField) -> Result<MaybePrimeSparse, OpError>
sig num_linear_sparse_exact_prime_to_dense as prime_to_dense(matrix: PrimeSparse) -> Result<Tensor<2, Int>, OpError>
