sig num_linear_sparse_exact_prime_rref as prime_rref(matrix: PrimeSparse) -> Result<PrimeRref, OpError>
sig num_linear_sparse_exact_dixon_multi as solve_dixon_multi(matrix: RationalSparse, rhs: Tensor<2, Real>) -> Result<Option<Tensor<2, Real>>, OpError>
codec PrimeField sparse_exact_field_to_wire sparse_exact_field_from_wire
codec RationalSparse sparse_exact_rational_to_wire sparse_exact_rational_from_wire
codec PrimeSparse sparse_exact_prime_to_wire sparse_exact_prime_from_wire
codec MaybePrimeSparse to_value sparse_exact_maybe_prime_from_wire
codec RationalRref to_value sparse_exact_rational_rref_from_wire
codec PrimeRref to_value sparse_exact_prime_rref_from_wire

prelude SparseExact
| open Rssn_Modular
|
| ## A checked prime field with a reusable reduction context.
| type PrimeField = | PrimeField(Value)
| type RationalSparse = | RationalSparse(Value)
| type PrimeSparse = | PrimeSparse(Value)
| type MaybePrimeSparse = Option<PrimeSparse>
| type RationalDense = { rows: Int, cols: Int, values: Tensor<1, Real> }
| type RcmPermutation = { permutation: Tensor<1, Int>, inverse: Tensor<1, Int> }
| type RationalRref = { matrix: RationalSparse, pivots: Tensor<1, Int> }
| type PrimeRref = { matrix: PrimeSparse, pivots: Tensor<1, Int> }
|
| fn sparse_exact_field_to_wire(field: PrimeField): Value =
|     match field with
|     | PrimeField(wire) -> wire
| fn sparse_exact_field_from_wire(wire: Value): Result<PrimeField, OpError> = Ok(PrimeField(wire))
| fn sparse_exact_rational_to_wire(matrix: RationalSparse): Value =
|     match matrix with
|     | RationalSparse(wire) -> wire
| fn sparse_exact_rational_from_wire(wire: Value): Result<RationalSparse, OpError> = Ok(RationalSparse(wire))
| fn sparse_exact_prime_to_wire(matrix: PrimeSparse): Value =
|     match matrix with
|     | PrimeSparse(wire) -> wire
| fn sparse_exact_prime_from_wire(wire: Value): Result<PrimeSparse, OpError> = Ok(PrimeSparse(wire))
| fn sparse_exact_maybe_prime_from_wire(wire: Value): Result<MaybePrimeSparse, OpError> =
|     match from_value<Option<Value>>(wire) with
|     | Ok(Some(matrix)) -> Ok(Some(PrimeSparse(matrix)))
|     | Ok(None) -> Ok(None)
|     | Err(failure) -> Err(failure)
| fn sparse_exact_rational_rref_from_wire(wire: Value): Result<RationalRref, OpError> =
|     match from_value<{ matrix: Value, pivots: Tensor<1, Int> }>(wire) with
|     | Ok(result) -> Ok({ matrix = RationalSparse(result.matrix), pivots = result.pivots })
|     | Err(failure) -> Err(failure)
| fn sparse_exact_prime_rref_from_wire(wire: Value): Result<PrimeRref, OpError> =
|     match from_value<{ matrix: Value, pivots: Tensor<1, Int> }>(wire) with
|     | Ok(result) -> Ok({ matrix = PrimeSparse(result.matrix), pivots = result.pivots })
|     | Err(failure) -> Err(failure)
|
| fn release_field(field: PrimeField): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [sparse_exact_field_to_wire(field)]) with
|     | Ok(wire) -> from_value<Bool>(wire)
|     | Err(failure) -> Err(failure)
| fn release_rational(matrix: RationalSparse): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [sparse_exact_rational_to_wire(matrix)]) with
|     | Ok(wire) -> from_value<Bool>(wire)
|     | Err(failure) -> Err(failure)
| fn release_prime(matrix: PrimeSparse): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [sparse_exact_prime_to_wire(matrix)]) with
|     | Ok(wire) -> from_value<Bool>(wire)
|     | Err(failure) -> Err(failure)

