codec Pcg32 pcg32_to_wire pcg32_from_wire
prelude Mcmc
| ## Explicit deterministic stream owned by the current RSSN session.
| type Pcg32 = | Pcg32(Value)
|
| fn pcg32_to_wire(stream: Pcg32): Value =
|     match stream with
|     | Pcg32(value) -> value
|
| fn pcg32_from_wire(value: Value): Result<Pcg32, OpError> = Ok(Pcg32(value))
|
| fn release(stream: Pcg32): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [pcg32_to_wire(stream)]) with
|     | Ok(value) -> from_value<Bool>(value)
|     | Err(error) -> Err(error)

