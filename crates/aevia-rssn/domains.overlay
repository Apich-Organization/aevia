sig num_cad_mesh_boolean as mesh_boolean(left: CadMesh, right: CadMesh, operation: String) -> Result<CadMesh, OpError>
sig num_cad_step_read_text as read_step_text(text: String) -> Result<CadSolids, OpError>

codec CadMesh cad_mesh_to_wire cad_mesh_from_wire
codec CadSolids - cad_solids_from_wire
codec CadWeld - cad_weld_from_wire
codec CadRepair - cad_repair_from_wire
prelude Cad
| ## Session-owned triangle mesh with coherent length coordinates.
| type CadMesh = | CadMesh(Value)
|
| ## Indexed geometry. Each row of either tensor has three entries.
| type CadArrays = { vertices: Tensor<2, Float[Length]>, triangles: Tensor<2, Int> }
|
| type CadSolids = Tensor<1, CadMesh>
|
| type CadWeld = { mesh: CadMesh, merged_vertices: Int }
| type CadRepair = { mesh: CadMesh, merged_vertices: Int, removed_degenerate: Int, filled_holes: Int, flipped: Int }
|
| fn cad_mesh_to_wire(mesh: CadMesh): Value =
|     match mesh with
|     | CadMesh(value) -> value
|
| fn cad_mesh_from_wire(value: Value): Result<CadMesh, OpError> =
|     Ok(CadMesh(value))
|
| fn cad_solids_from_wire(value: Value): Result<CadSolids, OpError> =
|     match from_value<Tensor<1, Value>>(value) with
|     | Ok(parts) -> Ok(map(fn (part: Value) => CadMesh(part), parts))
|     | Err(failure) -> Err(failure)
|
| fn cad_weld_from_wire(value: Value): Result<CadWeld, OpError> =
|     match from_value<{ mesh: Value, merged_vertices: Int }>(value) with
|     | Ok(result) -> Ok({ mesh = CadMesh(result.mesh), merged_vertices = result.merged_vertices })
|     | Err(failure) -> Err(failure)
|
| fn cad_repair_from_wire(value: Value): Result<CadRepair, OpError> =
|     match from_value<{ mesh: Value, merged_vertices: Int, removed_degenerate: Int, filled_holes: Int, flipped: Int }>(value) with
|     | Ok(result) -> Ok({ mesh = CadMesh(result.mesh), merged_vertices = result.merged_vertices, removed_degenerate = result.removed_degenerate, filled_holes = result.filled_holes, flipped = result.flipped })
|     | Err(failure) -> Err(failure)
|
| fn release_mesh(mesh: CadMesh): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [cad_mesh_to_wire(mesh)]) with
|     | Ok(value) -> from_value<Bool>(value)
|     | Err(failure) -> Err(failure)

