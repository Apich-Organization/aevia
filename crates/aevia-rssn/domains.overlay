# --- Multiprecision ----------------------------------------------------------
prelude Multiprecision
| ## Binary precision and exponent limits for a finite dyadic.
| type DyadicLimits = { min_precision: Int, max_precision: Int, min_exponent: Int, max_exponent: Int }
|
| ## A finite exact dyadic equal to mantissa * 2^exponent.
| ## Nonzero mantissas have precision bits. Zero has exponent zero.
| type Dyadic = { mantissa: Int, exponent: Int, precision: Int }
|
| ## A closed interval with a nonnegative dyadic radius.
| type DyadicBall = { midpoint: Dyadic, radius: Dyadic }
|
| ## A pair of certified sine and cosine enclosures.
| type DyadicSinCos = { sin: DyadicBall, cos: DyadicBall }
|
| ## Endpoints rounded outward to the requested bit precision.
| type DyadicBounds = { lower: Dyadic, upper: Dyadic }
|
| ## A closed complex rectangle with independent real and imaginary dyadic intervals.
| type DyadicRectangle = { real: DyadicBall, imag: DyadicBall }
|

sig num_mp_real_zero as zero_dyadic(precision: Int) -> Result<Dyadic, OpError>
sig num_mp_real_one as one_dyadic(precision: Int) -> Result<Dyadic, OpError>
