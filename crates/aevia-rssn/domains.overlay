codec ObjectiveTape optimizer_tape_to_wire optimizer_tape_from_wire
codec Objective optimizer_objective_to_wire optimizer_objective_from_wire
codec RegressionModel optimizer_regression_to_wire optimizer_regression_from_wire

prelude Optimizer
| type SqpShape = { equalities: Int, inequalities: Int }
| type SqpSparseEntries = { rows: Tensor<1, Int>, columns: Tensor<1, Int>, values: Tensor<1, Float> }
| type SqpEvaluation = { objective: Float, gradient: Tensor<1, Float>, constraints: Tensor<1, Float>, jacobian: SqpSparseEntries }
| type SqpResult = { x: Tensor<1, Float>, objective: Float, equality_multipliers: Tensor<1, Float>, inequality_multipliers: Tensor<1, Float>, iterations: Int, evaluations: Int, kkt_residual: Float, converged: Bool }
|
| fn sqp_solve(initial: Tensor<1, Float>, shape: SqpShape, tolerance: Float, trust_radius: Float, max_iterations: Int, max_evaluations: Int, evaluate: (Tensor<1, Float>) -> SqpEvaluation, hessian: (Tensor<1, Float>, Tensor<1, Float>, Tensor<1, Float>) -> SqpSparseEntries): Result<SqpResult, OpError> =
|     match Rssn.call_ho("num_sqp_solve", [to_value(initial), to_value(shape), to_value(tolerance), to_value(trust_radius), to_value(max_iterations), to_value(max_evaluations)], [to_callback(evaluate), to_callback(hessian)]) with
|     | Ok(wire) -> from_value<SqpResult>(wire)
|     | Err(failure) -> Err(failure)
| fn sqp_oracle_objective(point: Tensor<1, Float>, shape: SqpShape, evaluate: (Tensor<1, Float>) -> SqpEvaluation): Result<Float, OpError> =
|     match Rssn.call_ho("num_sqp_oracle_objective", [to_value(point), to_value(shape)], [to_callback(evaluate)]) with
|     | Ok(wire) -> from_value<Float>(wire)
|     | Err(failure) -> Err(failure)
| fn sqp_oracle_gradient(point: Tensor<1, Float>, shape: SqpShape, evaluate: (Tensor<1, Float>) -> SqpEvaluation): Result<Tensor<1, Float>, OpError> =
|     match Rssn.call_ho("num_sqp_oracle_gradient", [to_value(point), to_value(shape)], [to_callback(evaluate)]) with
|     | Ok(wire) -> from_value<Tensor<1, Float>>(wire)
|     | Err(failure) -> Err(failure)
| fn sqp_oracle_constraints(point: Tensor<1, Float>, shape: SqpShape, evaluate: (Tensor<1, Float>) -> SqpEvaluation): Result<Tensor<1, Float>, OpError> =
|     match Rssn.call_ho("num_sqp_oracle_constraints", [to_value(point), to_value(shape)], [to_callback(evaluate)]) with
|     | Ok(wire) -> from_value<Tensor<1, Float>>(wire)
|     | Err(failure) -> Err(failure)
| fn sqp_oracle_jacobian(point: Tensor<1, Float>, shape: SqpShape, evaluate: (Tensor<1, Float>) -> SqpEvaluation): Result<SqpSparseEntries, OpError> =
|     match Rssn.call_ho("num_sqp_oracle_jacobian", [to_value(point), to_value(shape)], [to_callback(evaluate)]) with
|     | Ok(wire) -> from_value<SqpSparseEntries>(wire)
|     | Err(failure) -> Err(failure)
| fn sqp_oracle_hessian(point: Tensor<1, Float>, equality_multipliers: Tensor<1, Float>, inequality_multipliers: Tensor<1, Float>, hessian: (Tensor<1, Float>, Tensor<1, Float>, Tensor<1, Float>) -> SqpSparseEntries): Result<SqpSparseEntries, OpError> =
|     match Rssn.call_ho("num_sqp_oracle_hessian", [to_value(point), to_value(equality_multipliers), to_value(inequality_multipliers)], [to_callback(hessian)]) with
|     | Ok(wire) -> from_value<SqpSparseEntries>(wire)
|     | Err(failure) -> Err(failure)
|
| ## Immutable source tape with explicit normalized references.
| type ObjectiveTape = | ObjectiveTape(Value)
| type Objective = | Objective(Value)
| type RegressionModel = | RegressionModel(Value)
| type ObjectiveEvaluation = { value: Float, gradient: Tensor<1, Float> }
| type OptimizerOptions = { iterations: Int, evaluations: Int, tolerance: Float, gradient_tolerance: Float, seed: Int }
| type OptimizerResult = { point: Tensor<1, Float>, cost: Float, iterations: Int, cost_evals: Int, converged: Bool, termination: String }
|
| fn optimizer_tape_to_wire(tape: ObjectiveTape): Value =
|     match tape with
|     | ObjectiveTape(wire) -> wire
| fn optimizer_tape_from_wire(wire: Value): Result<ObjectiveTape, OpError> = Ok(ObjectiveTape(wire))
| fn optimizer_objective_to_wire(problem: Objective): Value =
|     match problem with
|     | Objective(wire) -> wire
| fn optimizer_objective_from_wire(wire: Value): Result<Objective, OpError> = Ok(Objective(wire))
| fn optimizer_regression_to_wire(model: RegressionModel): Value =
|     match model with
|     | RegressionModel(wire) -> wire
| fn optimizer_regression_from_wire(wire: Value): Result<RegressionModel, OpError> = Ok(RegressionModel(wire))
|
| fn optimizer_release(wire: Value): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [wire]) with
|     | Ok(result) -> from_value<Bool>(result)
|     | Err(failure) -> Err(failure)
| fn release_tape(tape: ObjectiveTape): Result<Bool, OpError> = optimizer_release(optimizer_tape_to_wire(tape))
| fn release_objective(problem: Objective): Result<Bool, OpError> = optimizer_release(optimizer_objective_to_wire(problem))
| fn release_model(model: RegressionModel): Result<Bool, OpError> = optimizer_release(optimizer_regression_to_wire(model))

