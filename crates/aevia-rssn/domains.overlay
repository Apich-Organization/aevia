sig gf_neg(a: Int, p: Int) -> Result<Int, OpError>
sig gf_inv(a: Int, p: Int) -> Result<Int, OpError>
sig gf_pow(a: Int, e: Int, p: Int) -> Result<Int, OpError>
sig gf_is_zero(a: Int, p: Int) -> Result<Bool, OpError>
sig gf_is_one(a: Int, p: Int) -> Result<Bool, OpError>
sig gf256_add(a: Int, b: Int) -> Result<Int, OpError>
sig gf256_mul(a: Int, b: Int) -> Result<Int, OpError>
sig gf256_div(a: Int, b: Int) -> Result<Int, OpError>
sig gf256_inv(a: Int) -> Result<Int, OpError>
sig gf256_pow(a: Int, e: Int) -> Result<Int, OpError>
sig gf256_exp(e: Int) -> Result<Int, OpError>
sig gf256_log(a: Int) -> Result<Int, OpError>
sig gfp_add(a: Tensor<1, Int>, b: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfp_sub(a: Tensor<1, Int>, b: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfp_mul(a: Tensor<1, Int>, b: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfp_gcd(a: Tensor<1, Int>, b: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfp_derivative(a: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfp_monic(a: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfp_degree(a: Tensor<1, Int>, p: Int) -> Result<Int, OpError>
sig gfp_eval(a: Tensor<1, Int>, x: Int, p: Int) -> Result<Int, OpError>
sig gfp_isirreducible(a: Tensor<1, Int>, p: Int) -> Result<Bool, OpError>
sig gfp_powmod(base: Tensor<1, Int>, e: Int, modulus: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfp_invmod(a: Tensor<1, Int>, modulus: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfx_add(a: Tensor<1, Int>, b: Tensor<1, Int>, modulus: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfx_sub(a: Tensor<1, Int>, b: Tensor<1, Int>, modulus: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfx_mul(a: Tensor<1, Int>, b: Tensor<1, Int>, modulus: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfx_div(a: Tensor<1, Int>, b: Tensor<1, Int>, modulus: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfx_neg(a: Tensor<1, Int>, modulus: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfx_inv(a: Tensor<1, Int>, modulus: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfx_pow(a: Tensor<1, Int>, e: Int, modulus: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gfx_reduce(a: Tensor<1, Int>, modulus: Tensor<1, Int>, p: Int) -> Result<Tensor<1, Int>, OpError>
sig gf256_poly_add(a: Tensor<1, Int>, b: Tensor<1, Int>) -> Result<Tensor<1, Int>, OpError>
sig gf256_poly_mul(a: Tensor<1, Int>, b: Tensor<1, Int>) -> Result<Tensor<1, Int>, OpError>
sig gf256_poly_mod(a: Tensor<1, Int>, b: Tensor<1, Int>) -> Result<Tensor<1, Int>, OpError>
sig gf256_poly_gcd(a: Tensor<1, Int>, b: Tensor<1, Int>) -> Result<Tensor<1, Int>, OpError>
sig gf256_poly_derivative(a: Tensor<1, Int>) -> Result<Tensor<1, Int>, OpError>
sig gf256_poly_scale(a: Tensor<1, Int>, c: Int) -> Result<Tensor<1, Int>, OpError>
sig gf256_poly_eval(a: Tensor<1, Int>, x: Int) -> Result<Int, OpError>
dynamic gf256_poly_divmod gfp_divmod gfp_egcd gfp_squarefree gfp_factor gfp_ddf gfp_edf gfp_berlekamp | tuple or ragged results (pairs of polynomials, lists of factors with multiplicities); decode with from_value<Tensor<1, Tensor<1, Int>>> or a record
dynamic gfp_norm | contract not yet pinned down by a test; typed once its normalisation convention is documented in the kernel
dynamic factor_mod is_irreducible_mod | the three-argument form (polynomial, prime, variable-or-flag) is not the coefficient-tensor API of gfp_*; left dynamic until its argument contract is documented

# --- Numeric ----------------------------------------------------------------
# The Numeric domain is not `typed`: an operator without a line here is still
# generated, as a dynamic wrapper. The operators below take plain numbers and
# rectangular lists and have a curated signature. The kernel computes them from
# literal numbers only, so a symbolic argument comes back unreduced and the
# wrapper reports `Err(NotReduced(..))`. Every answer is a floating-point number
# (`Float`), including counts and 0-based indices such as `qr_pivoted_rank` and
# `qr_pivoted_permutation`: the kernel encodes no exact integers here.
# Robust statistics.
sig mad(xs: Tensor<1, Float>) -> Result<Float, OpError>
sig mad_sigma(xs: Tensor<1, Float>) -> Result<Float, OpError>
sig trimmed_mean(xs: Tensor<1, Float>, proportion: Float) -> Result<Float, OpError>
sig winsorized_mean(xs: Tensor<1, Float>, proportion: Float) -> Result<Float, OpError>
sig huber_location(xs: Tensor<1, Float>, k: Float) -> Result<Float, OpError>
sig biweight_location(xs: Tensor<1, Float>, c: Float) -> Result<Float, OpError>
sig ecdf(xs: Tensor<1, Float>, x: Float) -> Result<Float, OpError>
sig kde(xs: Tensor<1, Float>, x: Float, bandwidth: Float) -> Result<Float, OpError>
sig bandwidth_silverman(xs: Tensor<1, Float>) -> Result<Float, OpError>
sig bandwidth_scott(xs: Tensor<1, Float>) -> Result<Float, OpError>
sig quantile_hf(xs: Tensor<1, Float>, p: Float, kind: Int) -> Result<Float, OpError>
# Windows and spectra. A complex signal is its real and imaginary parts.
sig hann_window(n: Int) -> Result<Tensor<1, Float>, OpError>
sig hamming_window(n: Int) -> Result<Tensor<1, Float>, OpError>
sig blackman_window(n: Int) -> Result<Tensor<1, Float>, OpError>
sig cross_correlation(xs: Tensor<1, Float>, ys: Tensor<1, Float>) -> Result<Tensor<1, Float>, OpError>
sig fftconv(xs: Tensor<1, Float>, ys: Tensor<1, Float>) -> Result<Tensor<1, Float>, OpError>
sig interpolate(xs: Tensor<1, Float>, ys: Tensor<1, Float>, x: Float) -> Result<Float, OpError>
sig fft_abs(xs: Tensor<1, Float>) -> Result<Tensor<1, Float>, OpError>
sig fft_re(xs: Tensor<1, Float>) -> Result<Tensor<1, Float>, OpError>
sig fft_im(xs: Tensor<1, Float>) -> Result<Tensor<1, Float>, OpError>
sig ifft_re(re: Tensor<1, Float>, im: Tensor<1, Float>) -> Result<Tensor<1, Float>, OpError>
sig ifft_im(re: Tensor<1, Float>, im: Tensor<1, Float>) -> Result<Tensor<1, Float>, OpError>
sig frft_re(re: Tensor<1, Float>, im: Tensor<1, Float>, order: Float) -> Result<Tensor<1, Float>, OpError>
sig frft_im(re: Tensor<1, Float>, im: Tensor<1, Float>, order: Float) -> Result<Tensor<1, Float>, OpError>
# Dense Krylov solves, low rank and rank-revealing QR.
sig minres_solve(a: Tensor<2, Float>, b: Tensor<1, Float>, tol: Float) -> Result<Tensor<1, Float>, OpError>
sig fgmres_solve(a: Tensor<2, Float>, b: Tensor<1, Float>, tol: Float) -> Result<Tensor<1, Float>, OpError>
sig bicgstab_l_solve(a: Tensor<2, Float>, b: Tensor<1, Float>, tol: Float) -> Result<Tensor<1, Float>, OpError>
sig randomized_singular_values(a: Tensor<2, Float>, k: Int) -> Result<Tensor<1, Float>, OpError>
sig lobpcg_eigenvalues(a: Tensor<2, Float>, k: Int, tol: Float) -> Result<Tensor<1, Float>, OpError>
sig qr_pivoted_rank(a: Tensor<2, Float>, tol: Float) -> Result<Float, OpError>
sig qr_pivoted_permutation(a: Tensor<2, Float>) -> Result<Tensor<1, Float>, OpError>
sig qr_pivoted_diagonal(a: Tensor<2, Float>) -> Result<Tensor<1, Float>, OpError>
# Functions sampled as an n x 2 list of (x, y) points, ascending in x.
sig function_l1_norm(points: Tensor<2, Float>) -> Result<Float, OpError>
sig function_l2_norm(points: Tensor<2, Float>) -> Result<Float, OpError>
sig function_inf_norm(points: Tensor<2, Float>) -> Result<Float, OpError>
sig function_inner(f: Tensor<2, Float>, g: Tensor<2, Float>) -> Result<Float, OpError>
sig function_project(f: Tensor<2, Float>, g: Tensor<2, Float>) -> Result<Tensor<2, Float>, OpError>
sig function_normalize(f: Tensor<2, Float>) -> Result<Tensor<2, Float>, OpError>
# Complex special functions: arguments are (re, im), results are [re, im].
sig lgamma_complex(re: Float, im: Float) -> Result<Tensor<1, Float>, OpError>
sig gamma_complex(re: Float, im: Float) -> Result<Tensor<1, Float>, OpError>
sig digamma_complex(re: Float, im: Float) -> Result<Tensor<1, Float>, OpError>
sig lambert_w_complex(re: Float, im: Float, branch: Int) -> Result<Tensor<1, Float>, OpError>
sig bessel_j_complex(order: Float, re: Float, im: Float) -> Result<Tensor<1, Float>, OpError>
sig bessel_i_complex(order: Float, re: Float, im: Float) -> Result<Tensor<1, Float>, OpError>
# Wavelets, bootstrap and sparse solves name a method, wavelet or statistic with a
# symbol. A symbol is an Aevia `Real` (`let haar = symbol("haar")`): bind it once,
# every `symbol(..)` call makes a distinct one (`haar#2`) that the kernel does
# not know.
sig dwt_approx(xs: Tensor<1, Float>, wavelet: Real) -> Result<Tensor<1, Float>, OpError>
sig dwt_detail(xs: Tensor<1, Float>, wavelet: Real) -> Result<Tensor<1, Float>, OpError>
sig idwt(approx: Tensor<1, Float>, detail: Tensor<1, Float>, wavelet: Real) -> Result<Tensor<1, Float>, OpError>
sig wavedec(xs: Tensor<1, Float>, wavelet: Real, levels: Int) -> Result<Tensor<1, Tensor<1, Float>>, OpError>
sig waverec(coefficients: Tensor<1, Tensor<1, Float>>, wavelet: Real) -> Result<Tensor<1, Float>, OpError>
sig dwt2(m: Tensor<2, Float>, wavelet: Real) -> Result<Tensor<3, Float>, OpError>
sig idwt2(ll: Tensor<2, Float>, lh: Tensor<2, Float>, hl: Tensor<2, Float>, hh: Tensor<2, Float>, wavelet: Real) -> Result<Tensor<2, Float>, OpError>
sig bootstrap_ci(xs: Tensor<1, Float>, statistic: Real, alpha: Float, resamples: Int, seed: Int) -> Result<Tensor<1, Float>, OpError>
sig sparse_solve(entries: Tensor<2, Float>, b: Tensor<1, Float>, tol: Float, method: Real) -> Result<Tensor<1, Float>, OpError>
sig amg_solve(entries: Tensor<2, Float>, b: Tensor<1, Float>, tol: Float, kind: Real) -> Result<Tensor<1, Float>, OpError>
# The finite-difference solvers are dimension free in the kernel: the space
# dimension is the nesting depth of the field (a line, a plane, a cube). An Aevia
# signature has one literal rank, so one kernel operator carries one signature per
# space dimension, each under its own name: the bare name `heat_fd` is the
# one-dimensional solver, `heat_fd_2d` and `heat_fd_3d` take `Tensor<2, Float>` and
# `Tensor<3, Float>` fields (indexed `u[i][j]`, `u[i][j][k]`, nodes spread evenly
# over the unit box, the first and last node on its boundary) and answer the field
# at `t_end` in the same shape. `boundary` is the constant Dirichlet value on the
# whole boundary. The advection velocity has one component per space dimension and
# the field is periodic.
sig heat_fd(alpha: Float, u0: Tensor<1, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<1, Float>, OpError>
sig heat_fd as heat_fd_2d(alpha: Float, u0: Tensor<2, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<2, Float>, OpError>
sig heat_fd as heat_fd_3d(alpha: Float, u0: Tensor<3, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<3, Float>, OpError>
sig wave_fd(c: Float, u0: Tensor<1, Float>, v0: Tensor<1, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<1, Float>, OpError>
sig wave_fd as wave_fd_2d(c: Float, u0: Tensor<2, Float>, v0: Tensor<2, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<2, Float>, OpError>
sig wave_fd as wave_fd_3d(c: Float, u0: Tensor<3, Float>, v0: Tensor<3, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<3, Float>, OpError>
sig poisson_fd(f: Tensor<1, Float>, boundary: Float) -> Result<Tensor<1, Float>, OpError>
sig poisson_fd as poisson_fd_2d(f: Tensor<2, Float>, boundary: Float) -> Result<Tensor<2, Float>, OpError>
sig poisson_fd as poisson_fd_3d(f: Tensor<3, Float>, boundary: Float) -> Result<Tensor<3, Float>, OpError>
sig advect_fd(velocity: Tensor<1, Float>, u0: Tensor<1, Float>, t_end: Float, steps: Int) -> Result<Tensor<1, Float>, OpError>
sig advect_fd as advect_fd_2d(velocity: Tensor<1, Float>, u0: Tensor<2, Float>, t_end: Float, steps: Int) -> Result<Tensor<2, Float>, OpError>
sig advect_fd as advect_fd_3d(velocity: Tensor<1, Float>, u0: Tensor<3, Float>, t_end: Float, steps: Int) -> Result<Tensor<3, Float>, OpError>
# Ragged arguments are tensors of tensors; polynomial equations are term tables
# [[coefficient, e1, .., en], ..], one per equation, with different term counts.
sig nested_dissection_order(adjacency: Tensor<1, Tensor<1, Float>>) -> Result<Tensor<1, Float>, OpError>
sig polynomial_system_roots(system: Tensor<1, Tensor<2, Float>>) -> Result<Tensor<3, Float>, OpError>
# Expression operators: the right-hand sides and variables are symbolic (`Real`
# terms), every other parameter is a number.
sig oscillatory_integral(f: Real, g: Real, x: Real, a: Float, b: Float, w: Float, n: Int) -> Result<Tensor<1, Float>, OpError>
sig anderson_fixed_point(g: Tensor<1, Real>, vars: Tensor<1, Real>, x0: Tensor<1, Float>, tol: Float) -> Result<Tensor<1, Float>, OpError>
sig newton_cg_minimize(f: Real, vars: Tensor<1, Real>, x0: Tensor<1, Float>) -> Result<Tensor<1, Float>, OpError>
sig ode_solve(rhs: Tensor<1, Real>, vars: Tensor<1, Real>, t: Real, y0: Tensor<1, Float>, t0: Float, t1: Float, tol: Float, method: Real) -> Result<Tensor<1, Float>, OpError>
sig ode_symplectic(accel: Tensor<1, Real>, vars: Tensor<1, Real>, q0: Tensor<1, Float>, p0: Tensor<1, Float>, t0: Float, t1: Float, steps: Int, method: Real) -> Result<Tensor<2, Float>, OpError>
sig ode_imex(f_ex: Tensor<1, Real>, f_im: Tensor<1, Real>, vars: Tensor<1, Real>, t: Real, y0: Tensor<1, Float>, t0: Float, t1: Float, steps: Int, scheme: Real) -> Result<Tensor<1, Float>, OpError>
sig ode_etdrk4(l: Tensor<2, Float>, f: Tensor<1, Real>, vars: Tensor<1, Real>, t: Real, u0: Tensor<1, Float>, t0: Float, t1: Float, steps: Int) -> Result<Tensor<1, Float>, OpError>
# Rank-polymorphic tensor operators. The kernel takes a nested list of any depth; an
# Aevia type has a literal rank, so each operator has one signature per rank, named
# `<op>_<rank>`: `tensor_norm_3` takes a `Tensor<3, Float>`. `tensor_inner_<r>` takes
# two tensors of rank r. `tensordot_<ra>_<rb>_<k>` contracts k axes of a rank-ra
# and a rank-rb tensor (`axes_a[i]` of `a` against `axes_b[i]` of `b`, 0-based) and
# has rank ra + rb - 2k (a `Float` when 0); ranks 1..4, k from 1 to min(ra, rb), results
# up to rank 4 (use `Rssn.dynamic` beyond that). The decompositions have signatures
# for tensors of rank 2, 3 and 4 and answer with the records declared in the
# `Numeric` prelude (`Hosvd3`, `Hooi3`, `CpFit`, `TensorTrain`). A rank argument of
# `0` in `ranks` keeps the full rank of that mode; `tt_dense_<r>` rebuilds a rank-r
# tensor from r cores of shape (left, n, right).
sig tensor_norm as tensor_norm_1(t: Tensor<1, Float>) -> Result<Float, OpError>
sig tensor_norm as tensor_norm_2(t: Tensor<2, Float>) -> Result<Float, OpError>
sig tensor_norm as tensor_norm_3(t: Tensor<3, Float>) -> Result<Float, OpError>
sig tensor_norm as tensor_norm_4(t: Tensor<4, Float>) -> Result<Float, OpError>
sig tensor_inner as tensor_inner_1(a: Tensor<1, Float>, b: Tensor<1, Float>) -> Result<Float, OpError>
sig tensor_inner as tensor_inner_2(a: Tensor<2, Float>, b: Tensor<2, Float>) -> Result<Float, OpError>
sig tensor_inner as tensor_inner_3(a: Tensor<3, Float>, b: Tensor<3, Float>) -> Result<Float, OpError>
sig tensor_inner as tensor_inner_4(a: Tensor<4, Float>, b: Tensor<4, Float>) -> Result<Float, OpError>
sig tensordot as tensordot_1_1_1(a: Tensor<1, Float>, b: Tensor<1, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Float, OpError>
sig tensordot as tensordot_1_2_1(a: Tensor<1, Float>, b: Tensor<2, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<1, Float>, OpError>
sig tensordot as tensordot_1_3_1(a: Tensor<1, Float>, b: Tensor<3, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<2, Float>, OpError>
sig tensordot as tensordot_1_4_1(a: Tensor<1, Float>, b: Tensor<4, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<3, Float>, OpError>
sig tensordot as tensordot_2_1_1(a: Tensor<2, Float>, b: Tensor<1, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<1, Float>, OpError>
sig tensordot as tensordot_2_2_1(a: Tensor<2, Float>, b: Tensor<2, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<2, Float>, OpError>
sig tensordot as tensordot_2_2_2(a: Tensor<2, Float>, b: Tensor<2, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Float, OpError>
sig tensordot as tensordot_2_3_1(a: Tensor<2, Float>, b: Tensor<3, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<3, Float>, OpError>
sig tensordot as tensordot_2_3_2(a: Tensor<2, Float>, b: Tensor<3, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<1, Float>, OpError>
sig tensordot as tensordot_2_4_1(a: Tensor<2, Float>, b: Tensor<4, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<4, Float>, OpError>
sig tensordot as tensordot_2_4_2(a: Tensor<2, Float>, b: Tensor<4, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<2, Float>, OpError>
sig tensordot as tensordot_3_1_1(a: Tensor<3, Float>, b: Tensor<1, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<2, Float>, OpError>
sig tensordot as tensordot_3_2_1(a: Tensor<3, Float>, b: Tensor<2, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<3, Float>, OpError>
sig tensordot as tensordot_3_2_2(a: Tensor<3, Float>, b: Tensor<2, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<1, Float>, OpError>
sig tensordot as tensordot_3_3_1(a: Tensor<3, Float>, b: Tensor<3, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<4, Float>, OpError>
sig tensordot as tensordot_3_3_2(a: Tensor<3, Float>, b: Tensor<3, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<2, Float>, OpError>
sig tensordot as tensordot_3_3_3(a: Tensor<3, Float>, b: Tensor<3, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Float, OpError>
sig tensordot as tensordot_3_4_2(a: Tensor<3, Float>, b: Tensor<4, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<3, Float>, OpError>
sig tensordot as tensordot_3_4_3(a: Tensor<3, Float>, b: Tensor<4, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<1, Float>, OpError>
sig tensordot as tensordot_4_1_1(a: Tensor<4, Float>, b: Tensor<1, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<3, Float>, OpError>
sig tensordot as tensordot_4_2_1(a: Tensor<4, Float>, b: Tensor<2, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<4, Float>, OpError>
sig tensordot as tensordot_4_2_2(a: Tensor<4, Float>, b: Tensor<2, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<2, Float>, OpError>
sig tensordot as tensordot_4_3_2(a: Tensor<4, Float>, b: Tensor<3, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<3, Float>, OpError>
sig tensordot as tensordot_4_3_3(a: Tensor<4, Float>, b: Tensor<3, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<1, Float>, OpError>
sig tensordot as tensordot_4_4_2(a: Tensor<4, Float>, b: Tensor<4, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<4, Float>, OpError>
sig tensordot as tensordot_4_4_3(a: Tensor<4, Float>, b: Tensor<4, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Tensor<2, Float>, OpError>
sig tensordot as tensordot_4_4_4(a: Tensor<4, Float>, b: Tensor<4, Float>, axes_a: Tensor<1, Int>, axes_b: Tensor<1, Int>) -> Result<Float, OpError>

sig hosvd as hosvd_2(t: Tensor<2, Float>, ranks: Tensor<1, Int>) -> Result<Hosvd2, OpError>
sig hosvd as hosvd_3(t: Tensor<3, Float>, ranks: Tensor<1, Int>) -> Result<Hosvd3, OpError>
sig hosvd as hosvd_4(t: Tensor<4, Float>, ranks: Tensor<1, Int>) -> Result<Hosvd4, OpError>
sig hooi as hooi_2(t: Tensor<2, Float>, ranks: Tensor<1, Int>, sweeps: Int, tol: Float) -> Result<Hooi2, OpError>
sig hooi as hooi_3(t: Tensor<3, Float>, ranks: Tensor<1, Int>, sweeps: Int, tol: Float) -> Result<Hooi3, OpError>
sig hooi as hooi_4(t: Tensor<4, Float>, ranks: Tensor<1, Int>, sweeps: Int, tol: Float) -> Result<Hooi4, OpError>
sig cp_als as cp_als_2(t: Tensor<2, Float>, rank: Int, sweeps: Int, seed: Int) -> Result<CpFit, OpError>
sig cp_als as cp_als_3(t: Tensor<3, Float>, rank: Int, sweeps: Int, seed: Int) -> Result<CpFit, OpError>
sig cp_als as cp_als_4(t: Tensor<4, Float>, rank: Int, sweeps: Int, seed: Int) -> Result<CpFit, OpError>
sig tt_svd as tt_svd_2(t: Tensor<2, Float>, tol: Float, max_rank: Int) -> Result<TensorTrain, OpError>
sig tt_svd as tt_svd_3(t: Tensor<3, Float>, tol: Float, max_rank: Int) -> Result<TensorTrain, OpError>
sig tt_svd as tt_svd_4(t: Tensor<4, Float>, tol: Float, max_rank: Int) -> Result<TensorTrain, OpError>
sig tt_dense as tt_dense_2(cores: Tensor<1, Tensor<3, Float>>) -> Result<Tensor<2, Float>, OpError>
sig tt_dense as tt_dense_3(cores: Tensor<1, Tensor<3, Float>>) -> Result<Tensor<3, Float>, OpError>
sig tt_dense as tt_dense_4(cores: Tensor<1, Tensor<3, Float>>) -> Result<Tensor<4, Float>, OpError>

# ---------------------------------------------------------------------------
# Rich types. Curated Aevia source that is placed ahead of the generated
# wrappers. Keep it to types and codecs: the arithmetic belongs to the kernel.
# ---------------------------------------------------------------------------
codec Perm perm_to_value perm_from_value

prelude Combinatorics
| ## A permutation of {0, .., n-1} as the list of images, 0-based like every Aevia
| ## index. The kernel's permutation operators are 1-based; the `Perm` codec shifts
| ## at the boundary, so no call site ever sees a 1-based list.
| type Perm = | Perm(Tensor<1, Int>)
| derive Eq, Show for Perm
|
| fn perm_images(p: Perm): Tensor<1, Int> =
|     match p with
|     | Perm(images) -> images
|
| fn perm_to_value(p: Perm): Value =
|     match p with
|     | Perm(images) -> to_value(map(fn (i: Int) => i + 1, images))
|
| fn perm_from_value(v: Value): Result<Perm, OpError> =
|     match from_value<Tensor<1, Int>>(v) with
|     | Ok(images) -> Ok(Perm(map(fn (i: Int) => i - 1, images)))
|     | Err(e) -> Err(e)
|

# --- Numeric: results of the tensor decompositions ----------------------------
# The kernel answers a list of unlike parts (`list(core, list(U_1, .., U_N), error)`)
# that no Aevia tensor type holds. `from_value<Tensor<1, Value>>` hands the parts out as
# handles, and these decoders give each its type. The types are decode-only.
codec Hosvd2 - hosvd2_from_value
codec Hosvd3 - hosvd3_from_value
codec Hosvd4 - hosvd4_from_value
codec Hooi2 - hooi2_from_value
codec Hooi3 - hooi3_from_value
codec Hooi4 - hooi4_from_value
codec CpFit - cpfit_from_value
codec TensorTrain - tensortrain_from_value

prelude Numeric
| ## Truncated higher-order SVD: the core, one factor matrix per mode (`factors[k]` is
| ## n_k x r_k with orthonormal columns) and the singular values of each mode unfolding.
| ## The tensor is `core` multiplied by `factors[k]` along mode k.
| type Hosvd2 = { core: Tensor<2, Float>, factors: Tensor<1, Tensor<2, Float>>, singular_values: Tensor<1, Tensor<1, Float>> }
| type Hosvd3 = { core: Tensor<3, Float>, factors: Tensor<1, Tensor<2, Float>>, singular_values: Tensor<1, Tensor<1, Float>> }
| type Hosvd4 = { core: Tensor<4, Float>, factors: Tensor<1, Tensor<2, Float>>, singular_values: Tensor<1, Tensor<1, Float>> }
|
| ## The Tucker approximation refined by higher-order orthogonal iteration, with its
| ## relative Frobenius error.
| type Hooi2 = { core: Tensor<2, Float>, factors: Tensor<1, Tensor<2, Float>>, error: Float }
| type Hooi3 = { core: Tensor<3, Float>, factors: Tensor<1, Tensor<2, Float>>, error: Float }
| type Hooi4 = { core: Tensor<4, Float>, factors: Tensor<1, Tensor<2, Float>>, error: Float }
|
| ## A CP decomposition: sum over r of weights[r] times the outer product of column r of
| ## every factor matrix, and the relative residual. Compare reconstructions, not factors:
| ## they are fixed only up to permutation and scaling.
| type CpFit = { weights: Tensor<1, Float>, factors: Tensor<1, Tensor<2, Float>>, residual: Float }
|
| ## A tensor train: `cores[k]` has shape (left, n_k, right), and the truncation error.
| type TensorTrain = { cores: Tensor<1, Tensor<3, Float>>, error: Float }
|
| ## The list of parts, checked to have `n` of them. A list of another length is
| ## answered with the mismatch the decoder would report for a non-list.
| fn expect_parts(wire: Value, n: Int): Result<Tensor<1, Value>, OpError> =
|     match from_value<Tensor<1, Value>>(wire) with
|     | Err(e) -> Err(e)
|     | Ok(parts) ->
|         if length(parts) == n then
|             Ok(parts)
|         else
|             match from_value<Float>(wire) with
|             | Err(e) -> Err(e)
|             | Ok(_) -> Ok(parts)
|
| ## The elements of a kernel list, each decoded by `from_value` (one function per element
| ## type: `from_value<T>` needs the concrete type at its call site).
| fn decode_matrices(wire: Value): Result<Tensor<1, Tensor<2, Float>>, OpError> =
|     match from_value<Tensor<1, Value>>(wire) with
|     | Err(e) -> Err(e)
|     | Ok(parts) ->
|         let decoded = map(fn (p: Value) => from_value<Tensor<2, Float>>(p), parts)
|         match fold(fn (acc: Result<Bool, OpError>, r: Result<Tensor<2, Float>, OpError>) =>
|             match acc with
|             | Err(e) -> Err(e)
|             | Ok(_) ->
|                 match r with
|                 | Err(e) -> Err(e)
|                 | Ok(_) -> Ok(true), Ok(true), decoded) with
|         | Err(e) -> Err(e)
|         | Ok(_) -> Ok(map(fn (r: Result<Tensor<2, Float>, OpError>) => match r with | Ok(x) -> x | Err(_) -> zeros(0, 0), decoded))
|
| fn decode_vectors(wire: Value): Result<Tensor<1, Tensor<1, Float>>, OpError> =
|     match from_value<Tensor<1, Value>>(wire) with
|     | Err(e) -> Err(e)
|     | Ok(parts) ->
|         let decoded = map(fn (p: Value) => from_value<Tensor<1, Float>>(p), parts)
|         match fold(fn (acc: Result<Bool, OpError>, r: Result<Tensor<1, Float>, OpError>) =>
|             match acc with
|             | Err(e) -> Err(e)
|             | Ok(_) ->
|                 match r with
|                 | Err(e) -> Err(e)
|                 | Ok(_) -> Ok(true), Ok(true), decoded) with
|         | Err(e) -> Err(e)
|         | Ok(_) -> Ok(map(fn (r: Result<Tensor<1, Float>, OpError>) => match r with | Ok(x) -> x | Err(_) -> zeros(0), decoded))
|
| fn decode_cores(wire: Value): Result<Tensor<1, Tensor<3, Float>>, OpError> =
|     match from_value<Tensor<1, Value>>(wire) with
|     | Err(e) -> Err(e)
|     | Ok(parts) ->
|         let decoded = map(fn (p: Value) => from_value<Tensor<3, Float>>(p), parts)
|         match fold(fn (acc: Result<Bool, OpError>, r: Result<Tensor<3, Float>, OpError>) =>
|             match acc with
|             | Err(e) -> Err(e)
|             | Ok(_) ->
|                 match r with
|                 | Err(e) -> Err(e)
|                 | Ok(_) -> Ok(true), Ok(true), decoded) with
|         | Err(e) -> Err(e)
|         | Ok(_) -> Ok(map(fn (r: Result<Tensor<3, Float>, OpError>) => match r with | Ok(x) -> x | Err(_) -> zeros(0, 0, 0), decoded))
|
| fn hosvd2_from_value(wire: Value): Result<Hosvd2, OpError> =
|     match expect_parts(wire, 3) with
|     | Err(e) -> Err(e)
|     | Ok(ps) ->
|         let core = from_value<Tensor<2, Float>>(at(ps, 0))?
|         let factors = decode_matrices(at(ps, 1))?
|         let sv = decode_vectors(at(ps, 2))?
|         Ok({ core = core, factors = factors, singular_values = sv })
|
| fn hooi2_from_value(wire: Value): Result<Hooi2, OpError> =
|     match expect_parts(wire, 3) with
|     | Err(e) -> Err(e)
|     | Ok(ps) ->
|         let core = from_value<Tensor<2, Float>>(at(ps, 0))?
|         let factors = decode_matrices(at(ps, 1))?
|         let err = from_value<Float>(at(ps, 2))?
|         Ok({ core = core, factors = factors, error = err })
|
| fn hosvd3_from_value(wire: Value): Result<Hosvd3, OpError> =
|     match expect_parts(wire, 3) with
|     | Err(e) -> Err(e)
|     | Ok(ps) ->
|         let core = from_value<Tensor<3, Float>>(at(ps, 0))?
|         let factors = decode_matrices(at(ps, 1))?
|         let sv = decode_vectors(at(ps, 2))?
|         Ok({ core = core, factors = factors, singular_values = sv })
|
| fn hooi3_from_value(wire: Value): Result<Hooi3, OpError> =
|     match expect_parts(wire, 3) with
|     | Err(e) -> Err(e)
|     | Ok(ps) ->
|         let core = from_value<Tensor<3, Float>>(at(ps, 0))?
|         let factors = decode_matrices(at(ps, 1))?
|         let err = from_value<Float>(at(ps, 2))?
|         Ok({ core = core, factors = factors, error = err })
|
| fn hosvd4_from_value(wire: Value): Result<Hosvd4, OpError> =
|     match expect_parts(wire, 3) with
|     | Err(e) -> Err(e)
|     | Ok(ps) ->
|         let core = from_value<Tensor<4, Float>>(at(ps, 0))?
|         let factors = decode_matrices(at(ps, 1))?
|         let sv = decode_vectors(at(ps, 2))?
|         Ok({ core = core, factors = factors, singular_values = sv })
|
| fn hooi4_from_value(wire: Value): Result<Hooi4, OpError> =
|     match expect_parts(wire, 3) with
|     | Err(e) -> Err(e)
|     | Ok(ps) ->
|         let core = from_value<Tensor<4, Float>>(at(ps, 0))?
|         let factors = decode_matrices(at(ps, 1))?
|         let err = from_value<Float>(at(ps, 2))?
|         Ok({ core = core, factors = factors, error = err })
|
| fn cpfit_from_value(wire: Value): Result<CpFit, OpError> =
|     match expect_parts(wire, 3) with
|     | Err(e) -> Err(e)
|     | Ok(ps) ->
|         let weights = from_value<Tensor<1, Float>>(at(ps, 0))?
|         let factors = decode_matrices(at(ps, 1))?
|         let residual = from_value<Float>(at(ps, 2))?
|         Ok({ weights = weights, factors = factors, residual = residual })
|
| fn tensortrain_from_value(wire: Value): Result<TensorTrain, OpError> =
|     match expect_parts(wire, 2) with
|     | Err(e) -> Err(e)
|     | Ok(ps) ->
|         let cores = decode_cores(at(ps, 0))?
|         let err = from_value<Float>(at(ps, 1))?
|         Ok({ cores = cores, error = err })
|
prelude NumberTheory
| ## An element of Z/nZ. The residue and its modulus travel together, so combining two
| ## moduli is an `Err`, never a silently wrong answer. The arithmetic is the kernel's
| ## (`modulo`, `invmod`, `powmod`); a residue is always in [0, n).
| type Zmod = | Zmod(Int, Int)
| derive Eq, Show for Zmod
|
| fn zmod(a: Int, n: Int): Result<Zmod, String> =
|     if n < 1 then
|         Err("zmod: the modulus must be positive")
|     else
|         match modulo(a, n) with
|         | Ok(r) -> Ok(Zmod(r, n))
|         | Err(e) -> Err("{e}")
|
| fn zmod_value(x: Zmod): Int =
|     match x with
|     | Zmod(a, _) -> a
|
| fn zmod_modulus(x: Zmod): Int =
|     match x with
|     | Zmod(_, n) -> n
|
| fn zmod_same(x: Zmod, y: Zmod): Result<Int, String> =
|     if zmod_modulus(x) == zmod_modulus(y) then
|         Ok(zmod_modulus(x))
|     else
|         Err("zmod: operands have different moduli")
|
| fn zmod_add(x: Zmod, y: Zmod): Result<Zmod, String> =
|     match zmod_same(x, y) with
|     | Ok(n) -> zmod(zmod_value(x) + zmod_value(y), n)
|     | Err(e) -> Err(e)
|
| fn zmod_sub(x: Zmod, y: Zmod): Result<Zmod, String> =
|     match zmod_same(x, y) with
|     | Ok(n) -> zmod(zmod_value(x) - zmod_value(y), n)
|     | Err(e) -> Err(e)
|
| fn zmod_mul(x: Zmod, y: Zmod): Result<Zmod, String> =
|     match zmod_same(x, y) with
|     | Ok(n) -> zmod(zmod_value(x) * zmod_value(y), n)
|     | Err(e) -> Err(e)
|
| fn zmod_neg(x: Zmod): Result<Zmod, String> = zmod(0 - zmod_value(x), zmod_modulus(x))
|
| ## The multiplicative inverse; `Err` when x is not a unit.
| fn zmod_inv(x: Zmod): Result<Zmod, String> =
|     match invmod(zmod_value(x), zmod_modulus(x)) with
|     | Ok(r) -> Ok(Zmod(r, zmod_modulus(x)))
|     | Err(e) -> Err("zmod_inv: {zmod_value(x)} is not invertible modulo {zmod_modulus(x)}")
|
| fn zmod_div(x: Zmod, y: Zmod): Result<Zmod, String> =
|     match zmod_inv(y) with
|     | Ok(inverse) -> zmod_mul(x, inverse)
|     | Err(e) -> Err(e)
|
| ## x^e for any integer e; a negative exponent inverts first.
| fn zmod_pow(x: Zmod, e: Int): Result<Zmod, String> =
|     if e < 0 then
|         match zmod_inv(x) with
|         | Ok(inverse) -> zmod_pow(inverse, 0 - e)
|         | Err(msg) -> Err(msg)
|     else
|         match powmod(zmod_value(x), e, zmod_modulus(x)) with
|         | Ok(r) -> Ok(Zmod(r, zmod_modulus(x)))
|         | Err(err) -> Err("{err}")
|
| ## The multiplicative order of x, when x is a unit.
| fn zmod_order(x: Zmod): Result<Int, String> =
|     match mult_order(zmod_value(x), zmod_modulus(x)) with
|     | Ok(k) -> Ok(k)
|     | Err(e) -> Err("{e}")
|

# --- Group and Graph: handle types ------------------------------------------
# Finite groups and graphs are inert kernel terms (`group(elements, table)`,
# `graph(n, edges)`). The Aevia types are nominal wrappers around the opaque
# `Value` handle, so a graph cannot be passed where a group is expected; the
# codec is one pair of functions per type, and every operator that mentions
# the type is converted by the generator.
codec Graph graph_to_value graph_from_value
codec Group group_to_value group_from_value
codec PermGroup permgroup_to_value permgroup_from_value

prelude Graph
| ## A graph as a kernel term. Vertices are 0..n-1; build one with `graph_complete`,
| ## `graph_cycle`, `graph_path`, `graph_empty` and `graph_add_edge`.
| type Graph = | Graph(Value)
|
| fn graph_to_value(g: Graph): Value =
|     match g with
|     | Graph(v) -> v
|
| fn graph_from_value(v: Value): Result<Graph, OpError> = Ok(Graph(v))
|

prelude Group
| import Rssn_Combinatorics { Perm, perm_to_value, perm_from_value }
|
| ## A finite group as a kernel term (`group(elements, table)`).
| type Group = | Group(Value)
|
| fn group_to_value(g: Group): Value =
|     match g with
|     | Group(v) -> v
|
| fn group_from_value(v: Value): Result<Group, OpError> = Ok(Group(v))
|
| ## A permutation group given by generators, one 0-based permutation per row. The
| ## kernel counts points from 1; the codec shifts at the boundary.
| type PermGroup = | PermGroup(Tensor<2, Int>)
|
| fn permgroup_to_value(g: PermGroup): Value =
|     match g with
|     | PermGroup(rows) -> to_value(rows + 1)
|
| fn permgroup_from_value(v: Value): Result<PermGroup, OpError> =
|     match from_value<Tensor<2, Int>>(v) with
|     | Ok(rows) -> Ok(PermGroup(rows - 1))
|     | Err(e) -> Err(e)
|

sig graph_empty(n: Int) -> Result<Graph, OpError>
sig graph_complete(n: Int) -> Result<Graph, OpError>
sig graph_path(n: Int) -> Result<Graph, OpError>
sig graph_cycle(n: Int) -> Result<Graph, OpError>
sig graph_node_count(g: Graph) -> Result<Int, OpError>
sig graph_is_directed(g: Graph) -> Result<Bool, OpError>
sig graph_add_node(g: Graph) -> Result<Graph, OpError>
sig graph_add_edge(g: Graph, u: Int, v: Int) -> Result<Graph, OpError>
sig graph_out_degree(g: Graph, u: Int) -> Result<Int, OpError>
sig graph_in_degree(g: Graph, u: Int) -> Result<Int, OpError>
sig graph_adjacency(g: Graph) -> Result<Tensor<2, Int>, OpError>
sig graph_laplacian(g: Graph) -> Result<Tensor<2, Int>, OpError>
sig graph_bfs(g: Graph, start: Int) -> Result<Tensor<1, Int>, OpError>
sig graph_dfs(g: Graph, start: Int) -> Result<Tensor<1, Int>, OpError>
sig graph_is_connected(g: Graph) -> Result<Bool, OpError>
sig graph_has_cycle(g: Graph) -> Result<Bool, OpError>
sig graph_chromatic_number(g: Graph) -> Result<Int, OpError>
sig graph_isomorphic(g: Graph, h: Graph) -> Result<Bool, OpError>
sig graph_complement(g: Graph) -> Result<Graph, OpError>
sig graph_disjoint_union(g: Graph, h: Graph) -> Result<Graph, OpError>
sig graph_join(g: Graph, h: Graph) -> Result<Graph, OpError>

sig cyclic_group(n: Int) -> Result<Group, OpError>
sig dihedral_group(n: Int) -> Result<Group, OpError>
sig symmetric_group(n: Int) -> Result<Group, OpError>
sig klein_four_group() -> Result<Group, OpError>
sig group_order(g: Group) -> Result<Int, OpError>
sig group_is_abelian(g: Group) -> Result<Bool, OpError>
sig group_is_simple(g: Group) -> Result<Bool, OpError>
sig group_is_solvable(g: Group) -> Result<Bool, OpError>
sig group_is_nilpotent(g: Group) -> Result<Bool, OpError>
sig group_is_valid(g: Group) -> Result<Bool, OpError>
sig group_class_count(g: Group) -> Result<Int, OpError>
sig group_exponent(g: Group) -> Result<Int, OpError>
sig group_sylow_count(g: Group, p: Int) -> Result<Int, OpError>

sig perm_compose(p: Perm, q: Perm) -> Result<Perm, OpError>
sig perm_inverse(p: Perm) -> Result<Perm, OpError>
sig perm_order(p: Perm) -> Result<Int, OpError>
sig perm_sign(p: Perm) -> Result<Int, OpError>
sig perm_group_order(g: PermGroup) -> Result<Int, OpError>
sig perm_group_is_abelian(g: PermGroup) -> Result<Bool, OpError>
sig perm_group_is_transitive(g: PermGroup) -> Result<Bool, OpError>
sig perm_group_is_solvable(g: PermGroup) -> Result<Bool, OpError>
sig perm_group_is_nilpotent(g: PermGroup) -> Result<Bool, OpError>
sig perm_group_contains(g: PermGroup, p: Perm) -> Result<Bool, OpError>
