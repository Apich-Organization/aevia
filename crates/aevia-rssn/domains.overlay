codec ModularMontgomery modular_montgomery_to_value modular_montgomery_from_value
codec ModularBarrett modular_barrett_to_value modular_barrett_from_value

prelude Modular
| ## Session-owned Montgomery reducer for an odd modulus.
| type ModularMontgomery = | ModularMontgomery(Value)
|
| ## Session-owned Barrett reducer for a modulus of at least two.
| type ModularBarrett = | ModularBarrett(Value)
|
| fn modular_montgomery_to_value(plan: ModularMontgomery): Value =
|     match plan with
|     | ModularMontgomery(wire) -> wire
|
| fn modular_montgomery_from_value(wire: Value): Result<ModularMontgomery, OpError> =
|     Ok(ModularMontgomery(wire))
|
| fn modular_barrett_to_value(plan: ModularBarrett): Value =
|     match plan with
|     | ModularBarrett(wire) -> wire
|
| fn modular_barrett_from_value(wire: Value): Result<ModularBarrett, OpError> =
|     Ok(ModularBarrett(wire))
|
| ## Releases the reducer and invalidates every copy of its handle.
| fn release_montgomery(plan: ModularMontgomery): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [modular_montgomery_to_value(plan)]) with
|     | Ok(wire) -> from_value<Bool>(wire)
|     | Err(failure) -> Err(failure)
|
| ## Releases the reducer and invalidates every copy of its handle.
| fn release_barrett(plan: ModularBarrett): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [modular_barrett_to_value(plan)]) with
|     | Ok(wire) -> from_value<Bool>(wire)
|     | Err(failure) -> Err(failure)
