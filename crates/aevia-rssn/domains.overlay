codec PreparedTransfer transfer_to_wire transfer_from_wire
codec IdentifiedEra era_to_wire era_from_wire
codec PreparedMpc mpc_to_wire mpc_from_wire
prelude Control
| ## Normalized linear model whose matrices are owned by the RSSN session.
| type PreparedStateSpace = | PreparedStateSpace(Value)
|
| fn state_space_to_wire(model: PreparedStateSpace): Value =
|     match model with
|     | PreparedStateSpace(value) -> value
|
| fn state_space_from_wire(value: Value): Result<PreparedStateSpace, OpError> =
|     Ok(PreparedStateSpace(value))
|
| fn release_state_space(model: PreparedStateSpace): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [state_space_to_wire(model)]) with
|     | Ok(value) -> from_value<Bool>(value)
|     | Err(failure) -> Err(failure)
|
| ## Session-owned SISO transfer model with descending normalized coefficients.
| type PreparedTransfer = | PreparedTransfer(Value)
|
| ## Parallel PID coefficients for normalized error and time.
| type PidGains = { kp: Float, ki: Float, kd: Float, filter_time: Option<Float> }
|
| type PidLimits = { low: Float, high: Float }
|
| ## Realised discrete model with no direct feedthrough.
| type IdentifiedEra = | IdentifiedEra(Value)
|
| type EraMatrices = { a: Tensor<2, Float>, b: Tensor<2, Float>, c: Tensor<2, Float>, order: Int }
|
| fn era_to_wire(model: IdentifiedEra): Value =
|     match model with
|     | IdentifiedEra(wire) -> wire
|
| fn era_from_wire(wire: Value): Result<IdentifiedEra, OpError> =
|     Ok(IdentifiedEra(wire))
|
| fn release_era(model: IdentifiedEra): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [era_to_wire(model)]) with
|     | Ok(wire) -> from_value<Bool>(wire)
|     | Err(failure) -> Err(failure)
|
| ## Prepared discrete MPC with reusable prediction and constraint matrices.
| type PreparedMpc = | PreparedMpc(Value)
|
| ## Normalized MPC weights, horizons and optional component bounds.
| type MpcSettings = { horizon: Int, control_horizon: Int, q: Tensor<1, Float>, r: Tensor<1, Float>, u_min: Option<Tensor<1, Float>>, u_max: Option<Tensor<1, Float>>, x_min: Option<Tensor<1, Float>>, x_max: Option<Tensor<1, Float>> }
|
| fn mpc_to_wire(plan: PreparedMpc): Value =
|     match plan with
|     | PreparedMpc(wire) -> wire
|
| fn mpc_from_wire(wire: Value): Result<PreparedMpc, OpError> =
|     Ok(PreparedMpc(wire))
|
| fn release_mpc(plan: PreparedMpc): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [mpc_to_wire(plan)]) with
|     | Ok(wire) -> from_value<Bool>(wire)
|     | Err(failure) -> Err(failure)
|
| ## Missing margins indicate no crossover on the analysis grid.
| type TransferMargins = { gain_db: Option<Float>, phase_degrees: Option<Float> }
|
| fn transfer_to_wire(model: PreparedTransfer): Value =
|     match model with
|     | PreparedTransfer(wire) -> wire
|
| fn transfer_from_wire(wire: Value): Result<PreparedTransfer, OpError> =
|     Ok(PreparedTransfer(wire))
|
| fn release_transfer(model: PreparedTransfer): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [transfer_to_wire(model)]) with
|     | Ok(wire) -> from_value<Bool>(wire)
|     | Err(failure) -> Err(failure)

