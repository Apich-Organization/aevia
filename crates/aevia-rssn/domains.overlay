sig num_analysis_simplex_budgeted as simplex_budgeted<d,e,c>(objective: Tensor<1, Float[e/d]>, constraints: Tensor<2, Float[c/d]>, relations: Tensor<1, String>, values: Tensor<1, Float[c]>, pricing: String, coordinate_reference: Float[d], objective_reference: Float[e], constraint_reference: Float[c], max_pivots: Int) -> Result<{ status: String, x: Tensor<1, Float[d]>, value: Option<Float[e]>, iterations: Option<Int>, bland_pivots: Option<Int> }, OpError>
sig num_convex_solve_lp as solve_linear_program<d,e,c>(objective: Tensor<1, Float[e/d]>, constraints: Tensor<2, Float[c/d]>, relations: Tensor<1, String>, values: Tensor<1, Float[c]>, coordinate_reference: Float[d], objective_reference: Float[e], constraint_reference: Float[c], lower: Tensor<1, Float[d]>, upper: Tensor<1, Float[d]>, upper_present: Tensor<1, Bool>, max_pivots: Int) -> Result<{ status: String, x: Tensor<1, Float[d]>, value: Option<Float[e]>, iterations: Option<Int>, bland_pivots: Option<Int> }, OpError>
