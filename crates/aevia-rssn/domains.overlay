# --- Numeric ----------------------------------------------------------------
# The Numeric domain is not `typed`: an operator without a line here is still
# generated, as a dynamic wrapper. The operators below take plain numbers and
# rectangular lists and have a curated signature. The kernel computes them from
# literal numbers only, so a symbolic argument comes back unreduced and the
# wrapper reports `Err(NotReduced(..))`. Every answer is a floating-point number
# (`Float`), including counts and 0-based indices such as `qr_pivoted_rank` and
# `qr_pivoted_permutation`: the kernel encodes no exact integers here.
# Exact algebra over normalized rational coefficient handles.
sig num_native_qlinalg_charpoly as exact_charpoly(matrix: ExactMatrix) -> Result<Option<Tensor<1, Real>>, OpError>
sig num_native_qlinalg_det_bareiss as exact_det_bareiss(matrix: ExactMatrix) -> Result<Int, OpError>
sig num_native_qlinalg_det_modular_int as exact_det_modular(matrix: ExactMatrix) -> Result<Int, OpError>
sig num_native_qlinalg_hermite_normal_form as exact_hermite_form(matrix: ExactMatrix) -> Result<Tensor<2, Int>, OpError>
sig num_native_qlinalg_hermite_normal_form_with_transform as exact_hermite(matrix: ExactMatrix) -> Result<HermiteForm, OpError>
sig num_native_qlinalg_smith_normal_form as exact_smith(matrix: ExactMatrix) -> Result<SmithForm, OpError>
sig num_native_qlinalg_smith_normal_form_diag as exact_smith_invariants(matrix: ExactMatrix) -> Result<Tensor<1, Int>, OpError>
sig num_native_qlinalg_solve_dixon as exact_solve_dixon(matrix: ExactMatrix, rhs: Tensor<1, Real>) -> Result<Option<Tensor<1, Real>>, OpError>
sig num_native_qlinalg_solve_mat as exact_solve_matrix(matrix: ExactMatrix, rhs: ExactMatrix) -> Result<ExactMatrixSolution, OpError>
sig num_native_qlinalg_solve_unique as exact_solve_unique(matrix: ExactMatrix, rhs: Tensor<1, Real>) -> Result<Option<Tensor<1, Real>>, OpError>

# Robust statistics.
# Finite-domain GLM link and variance functions.
mode Statrs typed
codec StatrsDistribution statrs_distribution_to_wire statrs_distribution_from_wire

sig num_statrs_distribution_new as prepare(name: String, parameters: Tensor<1, Float>) -> Result<StatrsDistribution, OpError>
sig num_statrs_distribution_pdf as pdf(distribution: StatrsDistribution, x: Float) -> Result<Float, OpError>
sig num_statrs_distribution_cdf as cdf(distribution: StatrsDistribution, x: Float) -> Result<Float, OpError>
sig num_statrs_distribution_sf as sf(distribution: StatrsDistribution, x: Float) -> Result<Float, OpError>
sig num_statrs_distribution_mean as mean(distribution: StatrsDistribution) -> Result<Float, OpError>
sig num_statrs_distribution_variance as variance(distribution: StatrsDistribution) -> Result<Float, OpError>
sig num_statrs_distribution_entropy as entropy(distribution: StatrsDistribution) -> Result<Float, OpError>
sig num_statrs_distribution_is_discrete as is_discrete(distribution: StatrsDistribution) -> Result<Bool, OpError>
sig num_statrs_distribution_is_signed_discrete as is_signed_discrete(distribution: StatrsDistribution) -> Result<Bool, OpError>

prelude Statrs
| ## A distribution prepared in the current RSSN session.
| type StatrsDistribution = | StatrsDistribution(Value)
|
| fn statrs_distribution_to_wire(distribution: StatrsDistribution): Value =
|     match distribution with
|     | StatrsDistribution(value) -> value
|
| fn statrs_distribution_from_wire(value: Value): Result<StatrsDistribution, OpError> =
|     Ok(StatrsDistribution(value))
|
| fn release_distribution(distribution: StatrsDistribution): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [statrs_distribution_to_wire(distribution)]) with
|     | Ok(value) -> from_value<Bool>(value)
|     | Err(failure) -> Err(failure)

prelude Statistics
| ## Portable fitted GLM diagnostics. Coefficients place the intercept first.
| type GlmFit = { beta: Tensor<1, Float>, se: Tensor<1, Float>, deviance: Float, null_deviance: Float, iterations: Int, converged: Bool, aic: Float, dispersion: Float, fitted: Tensor<1, Float> }
| type GlmModel = { estimation: GlmFit, link: String }
| type CoxFit = { beta: Tensor<1, Float>, se: Tensor<1, Float>, z: Tensor<1, Float>, p: Tensor<1, Float>, loglik: Float, iterations: Int, converged: Bool, concordance: Float }
| type KaplanMeier<t> = { times: Tensor<1, t>, at_risk: Tensor<1, Int>, events: Tensor<1, Int>, survival: Tensor<1, Float>, variance: Tensor<1, Float>, lower: Tensor<1, Float>, upper: Tensor<1, Float> }

sig num_survival_fit_cox as fit_cox<d>(time: Tensor<1, Float[d]>, event: Tensor<1, Bool>, covariates: Tensor<2, Float>, ties: String, max_iterations: Int, tolerance: Float) -> Result<CoxFit, OpError>
