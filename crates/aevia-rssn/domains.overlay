# The finite-difference solvers are dimension free in the kernel: the space
# dimension is the nesting depth of the field (a line, a plane, a cube). An Aevia
# signature has one literal rank, so one kernel operator carries one signature per
# space dimension, each under its own name: the bare name `heat_fd` is the
# one-dimensional solver, `heat_fd_2d` and `heat_fd_3d` take `Tensor<2, Float>` and
# `Tensor<3, Float>` fields (indexed `u[i][j]`, `u[i][j][k]`, nodes spread evenly
# over the unit box, the first and last node on its boundary) and answer the field
# at `t_end` in the same shape. `boundary` is the constant Dirichlet value on the
# whole boundary. The advection velocity has one component per space dimension and
# the field is periodic.
sig heat_fd(alpha: Float, u0: Tensor<1, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<1, Float>, OpError>
sig heat_fd as heat_fd_2d(alpha: Float, u0: Tensor<2, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<2, Float>, OpError>
sig heat_fd as heat_fd_3d(alpha: Float, u0: Tensor<3, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<3, Float>, OpError>
sig wave_fd(c: Float, u0: Tensor<1, Float>, v0: Tensor<1, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<1, Float>, OpError>
sig wave_fd as wave_fd_2d(c: Float, u0: Tensor<2, Float>, v0: Tensor<2, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<2, Float>, OpError>
sig wave_fd as wave_fd_3d(c: Float, u0: Tensor<3, Float>, v0: Tensor<3, Float>, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<3, Float>, OpError>
sig poisson_fd(f: Tensor<1, Float>, boundary: Float) -> Result<Tensor<1, Float>, OpError>
sig poisson_fd as poisson_fd_2d(f: Tensor<2, Float>, boundary: Float) -> Result<Tensor<2, Float>, OpError>
sig poisson_fd as poisson_fd_3d(f: Tensor<3, Float>, boundary: Float) -> Result<Tensor<3, Float>, OpError>
sig advect_fd(velocity: Tensor<1, Float>, u0: Tensor<1, Float>, t_end: Float, steps: Int) -> Result<Tensor<1, Float>, OpError>
sig advect_fd as advect_fd_2d(velocity: Tensor<1, Float>, u0: Tensor<2, Float>, t_end: Float, steps: Int) -> Result<Tensor<2, Float>, OpError>
sig advect_fd as advect_fd_3d(velocity: Tensor<1, Float>, u0: Tensor<3, Float>, t_end: Float, steps: Int) -> Result<Tensor<3, Float>, OpError>
sig advect_fd_upwind(velocity: Tensor<1, Float>, u0: Tensor<1, Float>, t_end: Float, steps: Int) -> Result<Tensor<1, Float>, OpError>
sig advect_fd_upwind as advect_fd_upwind_2d(velocity: Tensor<1, Float>, u0: Tensor<2, Float>, t_end: Float, steps: Int) -> Result<Tensor<2, Float>, OpError>
sig advect_fd_upwind as advect_fd_upwind_3d(velocity: Tensor<1, Float>, u0: Tensor<3, Float>, t_end: Float, steps: Int) -> Result<Tensor<3, Float>, OpError>
# The `_bc` solvers take the boundary kind as a symbol (`Real`, made once with
# `symbol("neumann")`, as `sparse_solve` takes its `method`): `dirichlet`,
# `neumann`, or a pattern of `d`/`n` letters, one per axis (`dn` in 2D: Dirichlet
# on the `x` faces, Neumann on the `y` faces) or one per face in the order
# `x-, x+, y-, y+, z-, z+`. `boundary` is the one number on the whole boundary (a
# Neumann value is the outward normal derivative); per-axis or per-face values
# are the kernel's list form and need `Rssn.dynamic`. Pure Neumann is singular:
# the data must balance (`sum_i w_i (f_i + b_i) = 0`) or the call answers
# `rssn.diag.incompatible`, and the solution returned has zero (trapezoid-weighted)
# mean.
sig heat_fd_bc(alpha: Float, u0: Tensor<1, Float>, kind: Real, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<1, Float>, OpError>
sig heat_fd_bc as heat_fd_bc_2d(alpha: Float, u0: Tensor<2, Float>, kind: Real, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<2, Float>, OpError>
sig heat_fd_bc as heat_fd_bc_3d(alpha: Float, u0: Tensor<3, Float>, kind: Real, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<3, Float>, OpError>
sig wave_fd_bc(c: Float, u0: Tensor<1, Float>, v0: Tensor<1, Float>, kind: Real, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<1, Float>, OpError>
sig wave_fd_bc as wave_fd_bc_2d(c: Float, u0: Tensor<2, Float>, v0: Tensor<2, Float>, kind: Real, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<2, Float>, OpError>
sig wave_fd_bc as wave_fd_bc_3d(c: Float, u0: Tensor<3, Float>, v0: Tensor<3, Float>, kind: Real, boundary: Float, t_end: Float, steps: Int) -> Result<Tensor<3, Float>, OpError>
sig poisson_fd_bc(f: Tensor<1, Float>, kind: Real, boundary: Float) -> Result<Tensor<1, Float>, OpError>
sig poisson_fd_bc as poisson_fd_bc_2d(f: Tensor<2, Float>, kind: Real, boundary: Float) -> Result<Tensor<2, Float>, OpError>
sig poisson_fd_bc as poisson_fd_bc_3d(f: Tensor<3, Float>, kind: Real, boundary: Float) -> Result<Tensor<3, Float>, OpError>
