dynamic gf256_poly_divmod gfp_divmod gfp_egcd gfp_squarefree gfp_factor gfp_ddf gfp_edf gfp_berlekamp | tuple or ragged results (pairs of polynomials, lists of factors with multiplicities); decode with from_value<Tensor<1, Tensor<1, Int>>> or a record
dynamic gfp_norm | contract not yet pinned down by a test; typed once its normalisation convention is documented in the kernel
dynamic factor_mod is_irreducible_mod | the three-argument form (polynomial, prime, variable-or-flag) is not the coefficient-tensor API of gfp_*; left dynamic until its argument contract is documented

# ---------------------------------------------------------------------------
# Rich types. Curated Aevia source that is placed ahead of the generated
# wrappers. Keep it to types and codecs: the arithmetic belongs to the kernel.
# ---------------------------------------------------------------------------
codec Perm perm_to_value perm_from_value

prelude Combinatorics
| ## A permutation of {0, .., n-1} as the list of images, 0-based like every Aevia
| ## index. The kernel's permutation operators are 1-based; the `Perm` codec shifts
| ## at the boundary, so no call site ever sees a 1-based list.
| type Perm = | Perm(Tensor<1, Int>)
| derive Eq, Show for Perm
|
| fn perm_images(p: Perm): Tensor<1, Int> =
|     match p with
|     | Perm(images) -> images
|
| fn perm_to_value(p: Perm): Value =
|     match p with
|     | Perm(images) -> to_value(map(fn (i: Int) => i + 1, images))
|
| fn perm_from_value(v: Value): Result<Perm, OpError> =
|     match from_value<Tensor<1, Int>>(v) with
|     | Ok(images) -> Ok(Perm(map(fn (i: Int) => i - 1, images)))
|     | Err(e) -> Err(e)
|

prelude NumberTheory
| ## An element of Z/nZ. The residue and its modulus travel together, so combining two
| ## moduli is an `Err`, never a silently wrong answer. The arithmetic is the kernel's
| ## (`modulo`, `invmod`, `powmod`); a residue is always in [0, n).
| type Zmod = | Zmod(Int, Int)
| derive Eq, Show for Zmod
|
| fn zmod(a: Int, n: Int): Result<Zmod, String> =
|     if n < 1 then
|         Err("zmod: the modulus must be positive")
|     else
|         match modulo(a, n) with
|         | Ok(r) -> Ok(Zmod(r, n))
|         | Err(e) -> Err("{e}")
|
| fn zmod_value(x: Zmod): Int =
|     match x with
|     | Zmod(a, _) -> a
|
| fn zmod_modulus(x: Zmod): Int =
|     match x with
|     | Zmod(_, n) -> n
|
| fn zmod_same(x: Zmod, y: Zmod): Result<Int, String> =
|     if zmod_modulus(x) == zmod_modulus(y) then
|         Ok(zmod_modulus(x))
|     else
|         Err("zmod: operands have different moduli")
|
| fn zmod_add(x: Zmod, y: Zmod): Result<Zmod, String> =
|     match zmod_same(x, y) with
|     | Ok(n) -> zmod(zmod_value(x) + zmod_value(y), n)
|     | Err(e) -> Err(e)
|
| fn zmod_sub(x: Zmod, y: Zmod): Result<Zmod, String> =
|     match zmod_same(x, y) with
|     | Ok(n) -> zmod(zmod_value(x) - zmod_value(y), n)
|     | Err(e) -> Err(e)
|
| fn zmod_mul(x: Zmod, y: Zmod): Result<Zmod, String> =
|     match zmod_same(x, y) with
|     | Ok(n) -> zmod(zmod_value(x) * zmod_value(y), n)
|     | Err(e) -> Err(e)
|
| fn zmod_neg(x: Zmod): Result<Zmod, String> = zmod(0 - zmod_value(x), zmod_modulus(x))
|
| ## The multiplicative inverse; `Err` when x is not a unit.
| fn zmod_inv(x: Zmod): Result<Zmod, String> =
|     match invmod(zmod_value(x), zmod_modulus(x)) with
|     | Ok(r) -> Ok(Zmod(r, zmod_modulus(x)))
|     | Err(e) -> Err("zmod_inv: {zmod_value(x)} is not invertible modulo {zmod_modulus(x)}")
|
| fn zmod_div(x: Zmod, y: Zmod): Result<Zmod, String> =
|     match zmod_inv(y) with
|     | Ok(inverse) -> zmod_mul(x, inverse)
|     | Err(e) -> Err(e)
|
| ## x^e for any integer e; a negative exponent inverts first.
| fn zmod_pow(x: Zmod, e: Int): Result<Zmod, String> =
|     if e < 0 then
|         match zmod_inv(x) with
|         | Ok(inverse) -> zmod_pow(inverse, 0 - e)
|         | Err(msg) -> Err(msg)
|     else
|         match powmod(zmod_value(x), e, zmod_modulus(x)) with
|         | Ok(r) -> Ok(Zmod(r, zmod_modulus(x)))
|         | Err(err) -> Err("{err}")
|
| ## The multiplicative order of x, when x is a unit.
| fn zmod_order(x: Zmod): Result<Int, String> =
|     match mult_order(zmod_value(x), zmod_modulus(x)) with
|     | Ok(k) -> Ok(k)
|     | Err(e) -> Err("{e}")
|

# --- Group and Graph: handle types ------------------------------------------
# Finite groups and graphs are inert kernel terms (`group(elements, table)`,
# `graph(n, edges)`). The Aevia types are nominal wrappers around the opaque
# `Value` handle, so a graph cannot be passed where a group is expected; the
# codec is one pair of functions per type, and every operator that mentions
# the type is converted by the generator.
codec Graph graph_to_value graph_from_value
codec Group group_to_value group_from_value
codec PermGroup permgroup_to_value permgroup_from_value

prelude Graph
| ## A graph as a kernel term. Vertices are 0..n-1; build one with `graph_complete`,
| ## `graph_cycle`, `graph_path`, `graph_empty` and `graph_add_edge`.
| type Graph = | Graph(Value)
|
| fn graph_to_value(g: Graph): Value =
|     match g with
|     | Graph(v) -> v
|
| fn graph_from_value(v: Value): Result<Graph, OpError> = Ok(Graph(v))
|

prelude Group
| import Rssn_Combinatorics { Perm, perm_to_value, perm_from_value }
|
| ## A finite group as a kernel term (`group(elements, table)`).
| type Group = | Group(Value)
|
| fn group_to_value(g: Group): Value =
|     match g with
|     | Group(v) -> v
|
| fn group_from_value(v: Value): Result<Group, OpError> = Ok(Group(v))
|
| ## A permutation group given by generators, one 0-based permutation per row. The
| ## kernel counts points from 1; the codec shifts at the boundary.
| type PermGroup = | PermGroup(Tensor<2, Int>)
|
| fn permgroup_to_value(g: PermGroup): Value =
|     match g with
|     | PermGroup(rows) -> to_value(rows + 1)
|
| fn permgroup_from_value(v: Value): Result<PermGroup, OpError> =
|     match from_value<Tensor<2, Int>>(v) with
|     | Ok(rows) -> Ok(PermGroup(rows - 1))
|     | Err(e) -> Err(e)
|

sig graph_empty(n: Int) -> Result<Graph, OpError>
sig graph_complete(n: Int) -> Result<Graph, OpError>
sig graph_path(n: Int) -> Result<Graph, OpError>
sig graph_cycle(n: Int) -> Result<Graph, OpError>
sig graph_node_count(g: Graph) -> Result<Int, OpError>
sig graph_is_directed(g: Graph) -> Result<Bool, OpError>
sig graph_add_node(g: Graph) -> Result<Graph, OpError>
sig graph_add_edge(g: Graph, u: Int, v: Int) -> Result<Graph, OpError>
sig graph_out_degree(g: Graph, u: Int) -> Result<Int, OpError>
sig graph_in_degree(g: Graph, u: Int) -> Result<Int, OpError>
sig graph_adjacency(g: Graph) -> Result<Tensor<2, Int>, OpError>
sig graph_laplacian(g: Graph) -> Result<Tensor<2, Int>, OpError>
sig graph_bfs(g: Graph, start: Int) -> Result<Tensor<1, Int>, OpError>
sig graph_dfs(g: Graph, start: Int) -> Result<Tensor<1, Int>, OpError>
sig graph_is_connected(g: Graph) -> Result<Bool, OpError>
sig graph_has_cycle(g: Graph) -> Result<Bool, OpError>
sig graph_chromatic_number(g: Graph) -> Result<Int, OpError>
sig graph_isomorphic(g: Graph, h: Graph) -> Result<Bool, OpError>
sig graph_complement(g: Graph) -> Result<Graph, OpError>
sig graph_disjoint_union(g: Graph, h: Graph) -> Result<Graph, OpError>
sig graph_join(g: Graph, h: Graph) -> Result<Graph, OpError>

sig cyclic_group(n: Int) -> Result<Group, OpError>
sig dihedral_group(n: Int) -> Result<Group, OpError>
sig symmetric_group(n: Int) -> Result<Group, OpError>
sig klein_four_group() -> Result<Group, OpError>
sig group_order(g: Group) -> Result<Int, OpError>
sig group_is_abelian(g: Group) -> Result<Bool, OpError>
sig group_is_simple(g: Group) -> Result<Bool, OpError>
sig group_is_solvable(g: Group) -> Result<Bool, OpError>
sig group_is_nilpotent(g: Group) -> Result<Bool, OpError>
sig group_is_valid(g: Group) -> Result<Bool, OpError>
sig group_class_count(g: Group) -> Result<Int, OpError>
sig group_exponent(g: Group) -> Result<Int, OpError>
sig group_sylow_count(g: Group, p: Int) -> Result<Int, OpError>

sig perm_compose(p: Perm, q: Perm) -> Result<Perm, OpError>
sig perm_inverse(p: Perm) -> Result<Perm, OpError>
