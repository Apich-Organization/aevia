# ---------------------------------------------------------------------------
# Typed domains. `mode typed`: a new kernel operator in these families fails
# the coverage test until it is given a `sig`, `dynamic` or `exclude` line.
# ---------------------------------------------------------------------------
mode Interpolation typed
sig num_interp_bilinear_grid_prepare as prepare_bilinear<X,Y,Cell>(xs: Tensor<1, Float[X]>, ys: Tensor<1, Float[Y]>, cells: Tensor<2, Float[Cell]>) -> Result<BilinearGrid, OpError>
sig num_interp_bilinear_grid_evaluate as interpolate<X,Y,Cell>(grid: BilinearGrid, x: Float[X], y: Float[Y], witness: Float[Cell]) -> Result<Float[Cell], OpError>
codec BilinearGrid bilinear_grid_to_wire bilinear_grid_from_wire
prelude Interpolation
| ## A validated grid owned by the current RSSN session.
| type BilinearGrid = | BilinearGrid(Value)
|
| fn bilinear_grid_to_wire(grid: BilinearGrid): Value =
|     match grid with
|     | BilinearGrid(value) -> value
|
| fn bilinear_grid_from_wire(value: Value): Result<BilinearGrid, OpError> = Ok(BilinearGrid(value))
|
| fn release(grid: BilinearGrid): Result<Bool, OpError> =
|     match Rssn.dynamic("num_native_release", [bilinear_grid_to_wire(grid)]) with
|     | Ok(value) -> from_value<Bool>(value)
|     | Err(error) -> Err(error)

